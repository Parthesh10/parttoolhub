---
import '../styles/global.css';
import { SITE, ADS, ANALYTICS } from '../site.config';
import { canonicalUrl } from '../lib/urls';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  /** Path starting with "/". Defaults to the current URL. */
  canonical?: string;
  ogImage?: string;
  /** Additional JSON-LD objects to emit for this page. */
  schema?: Record<string, unknown>[];
  /** Set true on utility pages you don't want indexed (e.g. 404). */
  noindex?: boolean;
}

const { title, description, canonical, ogImage = SITE.ogImage, schema = [], noindex = false } = Astro.props;

const pageUrl = canonicalUrl(canonical ?? Astro.url.pathname);
const ogImageUrl = new URL(ogImage, SITE.url).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;

const baseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description: SITE.tagline,
  },
  ...schema,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Pre-paint theme application — must run this early (before the
      stylesheet, before any body content) so there is no flash of the
      wrong theme. Light is the app's own default whenever no explicit
      choice is stored yet, even if the OS prefers dark; "system" is an
      explicit opt-in the visitor picks from the toggle in the header.
      Kept as a tiny inline script rather than an import so it can run
      synchronously with zero network request — see Header.astro for
      the toggle control that writes this same localStorage key.
    -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme'); // 'light' | 'dark' | 'system' | null
          if (t === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          } else if (t !== 'system') {
            document.documentElement.setAttribute('data-theme', 'light');
          }
          // t === 'system': leave data-theme unset so prefers-color-scheme decides.
        } catch (e) {}
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Content is kept in sync with the resolved theme by the pre-paint script below and by
         the toggle in Header.astro — a single unconditional tag, rather than two `media`-gated
         ones, since browsers don't apply those consistently once a manual override is involved. -->
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(baseSchema)} />

    {ADS.client && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADS.client}`}
        crossorigin="anonymous"
      />
    )}

    {ANALYTICS.ga4 && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS.ga4}`} />
        <script is:inline define:vars={{ id: ANALYTICS.ga4 }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', id, { anonymize_ip: true });
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute; left: -999px; top: 0; z-index: 100;
    background: var(--accent); color: #fff; padding: 0.5rem 1rem; border-radius: 0 0 var(--radius-sm) 0;
  }
  .skip-link:focus { left: 0; }
  main { padding-block: 1.5rem 3rem; }
</style>
