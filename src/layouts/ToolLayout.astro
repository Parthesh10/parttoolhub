---
/**
 * Shared shell for every /tools/<slug> page. Generates everything that
 * seo-rules.md says is identical across tools — breadcrumbs, <h1> + lead
 * sentence, metadata, JSON-LD, the "How to use" list, both ad slots, the FAQ,
 * Related Tools and the trust/review line — so a page file only supplies what
 * is unique to it: the widget (default slot), the numbered steps, the prose
 * sections of §3.1 (named `content` slot) and the FAQ entries.
 *
 * Page order is fixed by §3.1: breadcrumb → h1 → tool → How to use → [ad] →
 * content sections → FAQ → [ad] → related tools → trust line. The first ad
 * unit sits after "How to use", never above the tool or between the tool's
 * input and output (§8); the second after the FAQ. Two per page, never more.
 */
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AdSlot from '../components/AdSlot.astro';
import Faq from '../components/Faq.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { SITE } from '../site.config';
import { canonicalUrl } from '../lib/urls';
import { formatDate } from '../lib/dates';
import { AUTHOR_ID, WEBSITE_ID } from '../lib/schema';
import { categoryBySlug } from '../data/categories';
import { toolPath, type Tool } from '../data/tools';
import FavoriteStar from '../components/FavoriteStar.astro';

export interface Props {
  tool: Tool;
  /** 3–5 imperative one-line steps for the "How to use" section. Inline HTML allowed. */
  steps: string[];
  /** 3–6 real, searchable FAQ entries (seo-rules §3.3). */
  faq: { q: string; a: string }[];
  /** Extra JSON-LD objects beyond WebSite/Person/WebPage/FAQPage/BreadcrumbList — must pass tests/structured-data.test.ts. */
  schema?: Record<string, unknown>[];
}

const { tool, steps, faq, schema = [] } = Astro.props;
const category = categoryBySlug(tool.category);

if (steps.length < 3 || steps.length > 5) {
  throw new Error(`${tool.slug}: "How to use" needs 3–5 steps, got ${steps.length} (seo-rules §3.1 item 4)`);
}
if (faq.length < 3 || faq.length > 6) {
  throw new Error(`${tool.slug}: FAQ needs 3–6 entries, got ${faq.length} (seo-rules §3.3)`);
}

// WebPage, deliberately not SoftwareApplication: Google's Software App rich
// result requires an aggregateRating or review, which this site will never
// fabricate (seo-rules §2), so a SoftwareApplication item is reported as
// invalid by every validator and earns nothing. WebPage has no rich-result
// requirements and states only what the visitor can verify on the page.
// tests/structured-data.test.ts enforces the type and property allowlists.
const pageUrl = canonicalUrl(toolPath(tool));
const toolSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': pageUrl,
  // Must match what a visitor sees: the <h1> is tool.name, not the <title>.
  name: tool.name,
  description: tool.description,
  url: pageUrl,
  inLanguage: 'en',
  isAccessibleForFree: true,
  // The visible "Last reviewed" date. No datePublished: nothing on the page shows one.
  dateModified: tool.reviewedOn,
  author: { '@id': AUTHOR_ID },
  isPartOf: { '@id': WEBSITE_ID },
};
---

<Base
  title={tool.title}
  description={tool.description}
  schema={[toolSchema, ...schema]}
  tool={{ slug: tool.slug, category: tool.category }}
>
  <Breadcrumbs items={[{ label: category.name, href: `/${category.slug}` }, { label: tool.name }]} />

  <header class="hero">
    <div class="title-row">
      <h1>{tool.name}</h1>
      <FavoriteStar slug={tool.slug} name={tool.name} variant="title" />
    </div>
    <p class="lead">{tool.short}</p>
  </header>

  <slot />

  <article class="prose">
    <section aria-labelledby="how-to-use">
      <h2 id="how-to-use">How to use</h2>
      <ol class="steps">
        {steps.map((s) => <li set:html={s} />)}
      </ol>
    </section>

    <AdSlot slot="toolTop" format="horizontal" />

    <slot name="content" />
  </article>

  <Faq items={faq} heading={`${tool.name} FAQ`} />

  <AdSlot slot="toolBottom" format="rectangle" />

  <RelatedTools current={tool} />

  <p class="trust-line muted">
    Runs entirely in your browser: this page is a static file with no server behind it, so nothing you paste can be
    uploaded. Last reviewed <time datetime={tool.reviewedOn}>{formatDate(tool.reviewedOn)}</time> by <a href={SITE.authorUrl}>{tool.reviewedBy}</a>.
    {tool.spec && (
      <>
        {' '}Implements <a href={tool.spec.url} rel="noopener">{tool.spec.name}</a>.
      </>
    )}
  </p>
</Base>

<style>
  /* The 76ch reading cap belongs on the lead only: on .hero it was measured at the body font size
     and so capped the much larger h1 too, wrapping short tool names onto two lines. */
  .hero { margin-bottom: 1.25rem; }
  /* Title and its favourite pill share a row; the pill drops under a long title on a phone. */
  .title-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.9rem; margin-bottom: 0.5rem; }
  .title-row h1 { margin: 0; }
  .lead { font-size: 1.1rem; color: var(--text-muted); margin: 0; max-width: 76ch; }
  .steps li { margin-bottom: 0.45rem; }
  .trust-line { font-size: 0.875rem; margin-top: 2rem; max-width: 76ch; }
</style>
