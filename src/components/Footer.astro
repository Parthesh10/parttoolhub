---
import { SITE } from '../site.config';
import { CATEGORIES } from '../data/categories';
import { toolsInCategory, toolPath } from '../data/tools';
import { visibleGuides } from '../lib/guides';
import { GUIDES_HUB } from '../data/guides';
const year = new Date().getFullYear();
// Linked only once a guide exists, so the footer never points at an empty section.
const hasGuides = (await visibleGuides()).length > 0;
---

<footer class="site-footer" data-nav="footer">
  <div class="container grid">
    <div class="about">
      <span class="brand-mark">{SITE.name}</span>
      <p class="muted">{SITE.tagline}. Everything runs locally in your browser, and nothing you paste is uploaded.</p>
    </div>
    {CATEGORIES.map((c) => (
      <div>
        <span class="col-head"><a href={`/${c.slug}`}>{c.name}</a></span>
        <ul>
          {toolsInCategory(c.slug).slice(0, 5).map((t) => <li><a href={toolPath(t)}>{t.name}</a></li>)}
        </ul>
      </div>
    ))}
    <div>
      <span class="col-head">Site</span>
      <ul>
        {hasGuides && <li><a href={GUIDES_HUB}>Guides</a></li>}
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/privacy-policy">Privacy Policy</a></li>
        <li><a href="/terms">Terms of Use</a></li>
        <li><button type="button" id="footer-shortcuts" class="link-btn">Keyboard shortcuts</button></li>
        {SITE.github && <li><a href={SITE.github} rel="noopener">Source on GitHub</a></li>}
      </ul>
    </div>
  </div>
  <div class="container copy muted">
    © {year} <a href={SITE.authorUrl}>{SITE.author}</a>. Built and maintained by one person; every tool page is
    checked against the running tool before it ships.
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--border); background: var(--surface); margin-top: 2rem; font-size: 0.925rem; }
  /* 1.6fr next to repeat(auto-fit, ...) was invalid CSS (auto-fit only combines with fixed-size
     tracks), so browsers dropped the whole rule and the footer collapsed into one left-hand column.
     Now: the about blurb spans two rows on the left, the five categories and Site fill a 3x2 grid. */
  .grid { display: grid; grid-template-columns: minmax(200px, 1.3fr) repeat(3, minmax(0, 1fr)); gap: 2rem 2.5rem; padding-block: 2.25rem 1rem; }
  .about { grid-row: span 2; }
  .about p { max-width: 32ch; }
  .brand-mark { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; color: var(--text); }
  /* Same small-caps technical-label treatment as .eyebrow, without the leading dot —
     ties the footer's section headers into the rest of the type system. */
  .col-head {
    display: block; font-family: var(--mono); font-size: 0.75rem; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted);
  }
  .col-head a { color: inherit; }
  .col-head a:hover { color: var(--accent); text-decoration: none; }
  ul { list-style: none; padding: 0; margin: 0.6rem 0 0; }
  li { margin-bottom: 0.3rem; }
  a { color: var(--text-muted); }
  a:hover { color: var(--accent); }
  /* Styled to read as just another footer link; floating-tools.client.ts opens the
     shortcuts dialog on click (that overlay lives there, not here, per the "shared
     layout components stay pure HTML/CSS" rule this file otherwise follows). */
  .link-btn {
    border: 0; background: none; padding: 0; margin: 0; font: inherit; color: var(--text-muted);
    cursor: pointer; text-align: left;
  }
  .link-btn:hover { color: var(--accent); }
  .copy { padding-block: 1rem 1.5rem; font-size: 0.85rem; }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr 1fr; gap: 1.25rem; } .about { grid-column: 1 / -1; grid-row: auto; } }
</style>
