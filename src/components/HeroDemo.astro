---
/**
 * A live, working demo embedded in the homepage hero — the site says "paste,
 * adjust, copy" in prose right next to it, so this proves it in the same
 * breath rather than asking for trust. Runs the real AI Text Cleaner engine
 * (src/lib/text-clean.ts, the same one /tools/ai-text-cleaner uses), updates
 * on every keystroke, and links through to the full tool.
 *
 * Picked over the site's other 23 tools deliberately (was code-case-convert
 * in the first draft, swapped after feedback that identifier casing means
 * nothing to a first-time visitor): cleaning up AI-chatbot paste junk is the
 * one job almost everyone who lands here has actually needed recently, so it
 * reads as "this solves my problem" rather than "here is an arbitrary trick."
 *
 * Deliberately un-instrumented: this is a homepage decoration, not a tool
 * page, so it doesn't extend the analytics taxonomy in docs/ANALYTICS.md for
 * a click that isn't a real tool use — clicking through to the real tool
 * fires that page's own tool_view/tool_use normally.
 */
const DEFAULT_INPUT = 'I’m **totally** onboard, it’s the right call, and here’s why…';
---

<div class="hero-demo" id="hero-demo">
  <div class="demo-titlebar">
    <span class="demo-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="demo-file">live · ai-text-cleaner</span>
  </div>
  <div class="demo-body">
    <label class="demo-field-label" for="demo-input">Paste something an AI assistant wrote</label>
    <textarea id="demo-input" rows="3" spellcheck="false">{DEFAULT_INPUT}</textarea>

    <div class="demo-arrow" aria-hidden="true">↓ cleaned</div>

    <div class="demo-output-wrap">
      <textarea id="demo-output" rows="3" readonly spellcheck="false" aria-label="Cleaned result"></textarea>
    </div>
    <p class="demo-summary" id="demo-summary"></p>
    <p class="demo-detect" id="demo-detect" hidden>
      <a id="demo-detect-link" href="/" data-nav="handoff"></a>
    </p>
  </div>
  <a class="demo-cta" href="/tools/ai-text-cleaner" data-nav="handoff">
    Open the full tool <span aria-hidden="true">→</span>
  </a>
</div>

<script src="./hero-demo.client.ts"></script>

<style>
  .hero-demo {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  /* Viewfinder corner brackets — a small technical/instrument-panel cue, pure CSS. */
  .hero-demo::before,
  .hero-demo::after,
  .demo-body::before,
  .demo-body::after {
    content: ""; position: absolute; width: 14px; height: 14px; pointer-events: none;
    border-color: var(--accent); opacity: 0.55; z-index: 2;
  }
  .hero-demo::before { top: -1px; left: -1px; border-top: 2px solid; border-left: 2px solid; border-radius: var(--radius) 0 0 0; }
  .hero-demo::after { top: -1px; right: -1px; border-top: 2px solid; border-right: 2px solid; border-radius: 0 var(--radius) 0 0; }
  .demo-body::before { bottom: -1px; left: -1px; border-bottom: 2px solid; border-left: 2px solid; }
  .demo-body::after { bottom: -1px; right: -1px; border-bottom: 2px solid; border-right: 2px solid; }

  .demo-titlebar {
    display: flex; align-items: center; gap: 0.6rem;
    padding: 0.55rem 0.85rem; background: var(--surface-2); border-bottom: 1px solid var(--border);
  }
  .demo-dots { display: inline-flex; gap: 0.32rem; }
  .demo-dots i { width: 8px; height: 8px; border-radius: 50%; display: block; }
  .demo-dots i:nth-child(1) { background: #ec6a5e; }
  .demo-dots i:nth-child(2) { background: #f4bf4f; }
  .demo-dots i:nth-child(3) { background: #61c454; }
  .demo-file { font-family: var(--mono); font-size: 0.72rem; color: var(--text-muted); letter-spacing: 0.02em; }

  .demo-body { position: relative; padding: 1rem 1.1rem 1.1rem; }
  .demo-field-label { display: block; font-size: 0.72rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.35rem; }
  #demo-input, #demo-output {
    width: 100%; font: inherit; font-family: var(--mono); font-size: 0.85rem; line-height: 1.5; resize: none;
    padding: 0.6rem 0.7rem; border: 1px solid var(--border); border-radius: var(--radius-sm);
    background: var(--surface-2); color: var(--text);
  }
  #demo-input:focus { outline: 2px solid var(--accent); outline-offset: -1px; background: var(--surface); }
  .demo-arrow {
    text-align: center; font-family: var(--mono); font-size: 0.72rem; font-weight: 600;
    color: var(--success); margin: 0.5rem 0;
  }
  #demo-output { border-color: color-mix(in srgb, var(--success) 45%, var(--border)); }
  .demo-summary { margin: 0.55rem 0 0; font-family: var(--mono); font-size: 0.72rem; color: var(--text-muted); min-height: 1.3em; }
  /* UX-011: paste-to-detect suggestion, shown only when the pasted text looks like a
     format one of the other tools handles better than the AI Text Cleaner does. */
  .demo-detect { margin: 0.5rem 0 0; font-size: 0.78rem; }
  .demo-detect a {
    display: inline-flex; align-items: center; gap: 0.3rem;
    color: var(--accent); font-weight: 600;
  }

  .demo-cta {
    display: block; text-align: center; padding: 0.7rem; font-size: 0.85rem; font-weight: 600;
    color: var(--accent); border-top: 1px solid var(--border); background: var(--surface-2);
  }
  .demo-cta:hover { background: var(--accent-soft); text-decoration: none; }
</style>
