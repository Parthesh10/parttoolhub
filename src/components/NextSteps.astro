---
/**
 * "Next step" strip under the tool card (UI round 5a): links to related tools that open with this
 * tool's result filled in (plan in src/data/next-steps.ts). Real links, so they work and are
 * tracked (data-nav) like any other internal link; floating-tools.client.ts shows the strip once
 * there is a result, hides links whose `when` the result doesn't meet, and on click hands the
 * result over. Renders nothing for a tool without a plan.
 */
import type { Tool } from '../data/tools';
import { TOOLS, toolPath } from '../data/tools';
import { NEXT_STEPS } from '../data/next-steps';
import { categoryTintVar } from '../lib/category-tint';
import ToolIcon from './ToolIcon.astro';

export interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
const plan = NEXT_STEPS[tool.slug];
const steps = (plan?.steps ?? []).flatMap((s) => {
  const target = TOOLS.find((t) => t.slug === s.to);
  return target ? [{ ...s, target }] : [];
});
---

{plan && steps.length > 0 && (
  <aside class="next-steps" data-next-steps data-source={plan.source} data-from={tool.name} data-nav="next-step" aria-label="Continue with this result" hidden>
    <span class="ns-label" aria-hidden="true">Next step</span>
    <ul class="ns-list">
      {steps.map((s) => (
        <li data-when={s.when}>
          <a class="ns-link" href={toolPath(s.target)} title={`Open ${s.target.name} with this result`} style={`--tint: ${categoryTintVar(s.target.category)}`}>
            <span class="ns-icon"><ToolIcon slug={s.to} size={16} /></span>
            <span>{s.label}</span>
            <span class="ns-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}

<style>
  .next-steps {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.9rem;
    margin-top: 0.85rem; padding: 0.7rem 0.9rem;
    border: 1px dashed var(--border); border-radius: var(--radius);
  }
  .next-steps.ns-in { animation: ns-in 0.35s var(--ease-spring); }
  @keyframes ns-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  .ns-label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-muted); }
  .ns-list { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .ns-link {
    display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.35rem 0.75rem 0.35rem 0.4rem;
    border: 1px solid var(--border); border-radius: 999px; background: var(--surface);
    color: var(--text); font-size: 0.88rem; font-weight: 600; text-decoration: none;
    transition: border-color 0.15s, transform 0.15s var(--ease-spring), box-shadow 0.15s;
  }
  .ns-link:hover {
    text-decoration: none; transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--tint) 55%, var(--border));
    box-shadow: 0 2px 10px color-mix(in srgb, var(--tint) 18%, transparent);
  }
  .ns-link:active { transform: scale(0.97); }
  .ns-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .ns-icon {
    display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%;
    background: color-mix(in srgb, var(--tint) 14%, transparent); color: var(--tint);
  }
  .ns-arrow { color: var(--text-muted); transition: transform 0.15s var(--ease-spring); }
  .ns-link:hover .ns-arrow { transform: translateX(3px); color: var(--tint); }
  @media (pointer: coarse) { .ns-link { min-height: 44px; } }
  /* Under a two-pane tool that has broken out of the page column on a big monitor (global.css,
     UI audit B3), the strip takes the same width so it stays aligned with the card above it. */
  @media (min-width: 1300px) {
    :global(.tool:not(.is-fullscreen):has(> .panes)) ~ .next-steps {
      --tool-w: max(100%, min(100vw - 15rem, 1400px));
      width: var(--tool-w); margin-inline: calc((100% - var(--tool-w)) / 2);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .next-steps.ns-in { animation: none; }
    .ns-link:hover, .ns-link:hover .ns-arrow { transform: none; }
  }
</style>
