---
import { SITE } from '../site.config';
export interface Crumb { label: string; href?: string }
export interface Props { items: Crumb[] }
const { items } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ label: 'Home', href: '/' }, ...items].map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: new URL(c.href, SITE.url).href } : {}),
  })),
};
---

<nav class="crumbs" aria-label="Breadcrumb" data-nav="breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {items.map((c) => (
      <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
    ))}
  </ol>
</nav>
<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
  ol { list-style: none; display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0; margin: 0 0 1rem; font-size: 0.875rem; color: var(--text-muted); }
  li + li::before { content: '/'; margin-right: 0.35rem; opacity: 0.6; }
  a { color: var(--text-muted); }
</style>
