---
/**
 * JSON formatter / validator / minifier. Markup is server-rendered; behaviour
 * is attached by ./json-formatter.client.ts
 */
---

<section class="tool card" id="tool" data-tool="json-formatter">
  <div class="tool-toolbar">
    <button type="button" class="btn btn-sm" id="btn-fullscreen" aria-pressed="false">⛶ Fullscreen</button>
  </div>
  <div class="panes">
    <div class="pane">
      <div class="pane-head">
        <label for="input">Paste JSON</label>
        <span class="stat" id="input-stat" aria-live="polite">0 characters</span>
      </div>
      <div class="code-wrap">
        <div class="gutter" id="input-gutter" aria-hidden="true"><span>1</span></div>
        <textarea
          id="input"
          rows="14"
          spellcheck="false"
          autocomplete="off"
          placeholder={'{\n  "name": "Ada",\n  "active": true,\n  "tags": ["admin", "beta"]\n}'}
        ></textarea>
      </div>
      <div class="pane-actions">
        <button type="button" class="btn btn-sm" id="btn-paste">Paste</button>
        <button type="button" class="btn btn-sm" id="btn-sample">Load sample</button>
        <button type="button" class="btn btn-sm" id="btn-clear">Clear input</button>
        <button type="button" class="btn btn-sm" id="btn-reset-options">Reset options</button>
      </div>
      <p class="muted drop-hint">Or drop a .json/.txt file onto the box above.</p>
    </div>

    <div class="pane">
      <div class="pane-head">
        <label for="output">Result</label>
        <span class="stat" id="output-stat" aria-live="polite"></span>
      </div>
      <div class="code-wrap" id="output-code-wrap">
        <div class="gutter" id="output-gutter" aria-hidden="true"></div>
        <textarea id="output" rows="14" readonly spellcheck="false" placeholder="Formatted JSON appears here as you type"></textarea>
      </div>
      <div class="jt-root" id="output-tree"></div>
      <div class="pane-actions">
        <button type="button" class="btn btn-primary btn-sm" id="btn-copy">Copy to clipboard</button>
        <button type="button" class="btn btn-sm" id="btn-download">Download .json</button>
        <button type="button" class="btn btn-sm" id="btn-wrap" aria-pressed="false">No-wrap</button>
      </div>
      <div class="pane-actions" id="handoff-actions" hidden>
        <button type="button" class="btn btn-sm" id="btn-handoff-csv">Use in JSON to CSV →</button>
      </div>
      <p class="status-banner" id="status" hidden></p>
    </div>
  </div>

  <div class="options">
    <fieldset>
      <legend>Action</legend>
      <div class="row" role="group" aria-label="Format or minify">
        <button type="button" class="btn btn-sm" id="mode-format" aria-pressed="true">Format</button>
        <button type="button" class="btn btn-sm" id="mode-minify" aria-pressed="false">Minify</button>
      </div>
    </fieldset>

    <fieldset>
      <legend>View</legend>
      <div class="row" role="group" aria-label="Text or tree view">
        <button type="button" class="btn btn-sm" id="view-text" aria-pressed="true">Text</button>
        <button type="button" class="btn btn-sm" id="view-tree" aria-pressed="false">Tree</button>
      </div>
    </fieldset>

    <fieldset>
      <legend>Indent</legend>
      <div class="row">
        <label class="field">
          <span>Spacing</span>
          <select id="opt-indent">
            <option value="2">2 spaces</option>
            <option value="4">4 spaces</option>
            <option value="tab">Tab</option>
          </select>
        </label>
      </div>
    </fieldset>

    <fieldset>
      <legend>Keys</legend>
      <div class="checks">
        <label><input type="checkbox" id="opt-sort" /> Sort keys alphabetically</label>
      </div>
    </fieldset>
  </div>

  <p class="tool-toast" id="toast" role="status" aria-live="polite" hidden></p>
</section>

<script src="./json-formatter.client.ts"></script>

<style>
  /* Format/Minify, Wrap, Text/Tree pressed-state color and .drop-hint now come from
     global.css's shared rules — no per-tool override needed here. */

  /* JSON-002 tree view. Built via innerHTML in json-formatter.client.ts, so Astro's scoped-style
     attribute never reaches these elements (documented gotcha, CLAUDE.md) — every selector here
     needs :global(). */
  .jt-root {
    display: none; min-height: 200px; max-height: 60vh; overflow: auto; padding: 0.75rem;
    border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface-2);
    font-family: var(--mono); font-size: 0.9rem; line-height: 1.6;
  }
  .jt-root.is-visible { display: block; }
  :global(.jt-node) { margin: 0; }
  :global(.jt-node > summary) {
    cursor: pointer; list-style: none; padding: 0.05rem 0; border-radius: 3px;
  }
  :global(.jt-node > summary::-webkit-details-marker) { display: none; }
  :global(.jt-node > summary::before) { content: '▸'; display: inline-block; width: 1rem; color: var(--text-muted); }
  :global(.jt-node[open] > summary::before) { content: '▾'; }
  :global(.jt-node > summary:hover) { background: color-mix(in srgb, var(--accent) 10%, transparent); }
  :global(.jt-node > summary:focus-visible) { outline: 2px solid var(--accent); outline-offset: -2px; }
  :global(.jt-children) { margin-left: 1rem; padding-left: 0.75rem; border-left: 1px dashed var(--border); }
  :global(.jt-leaf) { padding: 0.05rem 0.3rem 0.05rem 1rem; border-radius: 3px; cursor: pointer; }
  :global(.jt-leaf:hover) { background: color-mix(in srgb, var(--accent) 10%, transparent); }
  :global(.jt-leaf:focus-visible) { outline: 2px solid var(--accent); outline-offset: -1px; }
  /* JSON-003 copy confirmation: a brief background flash, not a layout-shifting tooltip. */
  :global(.jt-leaf.jt-copied) { background: color-mix(in srgb, var(--success) 25%, transparent); }
  /* SEO-002 perf fix: the "N more items" notice for a truncated large array — deliberately not
     .jt-leaf (no cursor:pointer/hover, nothing to click or copy, just an explanation). */
  :global(.jt-truncated) { padding: 0.05rem 0 0.05rem 1rem; color: var(--text-muted); font-style: italic; }

  /* SITE-002: the status banner becomes a click target to jump to the error's line/column,
     only when it actually names one (toggled in json-formatter.client.ts). Starting here per
     this row's own scope; promote to global.css if/when another line/column-reporting tool adopts it. */
  #status.is-clickable { cursor: pointer; }
  #status.is-clickable:hover { filter: brightness(1.1); }
  #status.is-clickable:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  :global(.jt-key) { color: var(--accent-2); }
  :global(.jt-colon) { color: var(--text-muted); }
  :global(.jt-punct) { color: var(--text-muted); }
  :global(.jt-string) { color: var(--success); }
  :global(.jt-number), :global(.jt-boolean) { color: var(--accent); }
  :global(.jt-null) { color: var(--text-muted); font-style: italic; }
</style>
