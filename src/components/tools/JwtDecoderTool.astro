---
/** JWT decoder. Behaviour in ./jwt-decoder.client.ts */
---

<section class="tool card" id="tool" data-tool="jwt-decoder">
  <div class="tool-toolbar">
    <button type="button" class="btn btn-sm" id="btn-fullscreen" aria-pressed="false">⛶ Fullscreen</button>
  </div>
  <div class="single">
    <div class="pane-head">
      <label for="input">Paste a JWT</label>
      <span class="stat" id="input-stat" aria-live="polite"></span>
    </div>
    <textarea
      id="input"
      rows="6"
      spellcheck="false"
      autocomplete="off"
      placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.SIGNATURE"
    ></textarea>
    <div class="pane-actions">
      <button type="button" class="btn btn-sm" id="btn-paste">Paste</button>
      <button type="button" class="btn btn-sm" id="btn-sample">Load sample</button>
      <button type="button" class="btn btn-sm" id="btn-clear">Clear</button>
    </div>
    <p class="muted drop-hint">Or drop a .txt file containing the token onto the box above.</p>
  </div>

  <p class="status-banner" id="status" hidden></p>

  <div class="jwt-result" id="result" hidden>
    <div class="jwt-timing" id="timing"></div>

    <div class="jwt-claims" id="claims"></div>

    <div class="jwt-panes">
      <div class="pane">
        <div class="pane-head">
          <label for="header-out">Header</label>
        </div>
        <textarea id="header-out" rows="6" readonly spellcheck="false"></textarea>
        <div class="pane-actions">
          <button type="button" class="btn btn-sm" data-copy="header-out">Copy header</button>
        </div>
      </div>
      <div class="pane">
        <div class="pane-head">
          <label for="payload-out">Payload</label>
        </div>
        <textarea id="payload-out" rows="6" readonly spellcheck="false"></textarea>
        <div class="pane-actions">
          <button type="button" class="btn btn-sm" data-copy="payload-out">Copy payload</button>
        </div>
      </div>
    </div>
  </div>

  <p class="hint">This decodes the token so you can read its contents. It does not verify the signature: that requires the secret or public key the token was signed with, which never leaves your own server.</p>

  <p class="tool-toast" id="toast" role="status" aria-live="polite" hidden></p>
</section>

<script src="./jwt-decoder.client.ts"></script>

<style>
  .single textarea { min-height: 100px; }
  .jwt-panes { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem; }
  @media (max-width: 760px) { .jwt-panes { grid-template-columns: 1fr; } }
  .jwt-timing { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-top: 1rem; font-size: 0.9rem; }
  .jwt-timing :global(.v.expired) { color: var(--danger); }
  .jwt-timing :global(.v.valid) { color: var(--success); }

  /* JWT-002 claims table. Built via innerHTML in jwt-decoder.client.ts, so Astro's scoped-style
     attribute never reaches these elements (documented gotcha, CLAUDE.md) — :global() throughout. */
  .jwt-claims { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.25rem; }
  @media (max-width: 760px) { .jwt-claims { grid-template-columns: 1fr; } }
  :global(.jwt-claims-group h3) { margin: 0 0 0.4rem; font-size: 0.95rem; }
  :global(.jwt-claims-table) {
    width: 100%; border-collapse: collapse; font-size: 0.85rem; border: 1px solid var(--border);
    border-radius: var(--radius-sm); overflow: hidden;
  }
  :global(.jwt-claims-table td) { padding: 0.4rem 0.6rem; border-top: 1px solid var(--border); vertical-align: top; }
  :global(.jwt-claims-table tr:first-child td) { border-top: none; }
  :global(.jwt-claims-table .jc-key) { color: var(--text-muted); white-space: nowrap; width: 40%; }
  :global(.jwt-claims-table .jc-val) { font-family: var(--mono); word-break: break-word; }
</style>
