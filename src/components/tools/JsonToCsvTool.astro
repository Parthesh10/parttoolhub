---
/** JSON to CSV converter. Behaviour in ./json-to-csv.client.ts */
---

<section class="tool card" id="tool" data-tool="json-to-csv-converter">
  <div class="panes">
    <div class="pane">
      <div class="pane-head">
        <label for="input">Paste JSON</label>
        <span class="stat" id="input-stat" aria-live="polite">0 characters</span>
      </div>
      <textarea
        id="input"
        rows="14"
        spellcheck="false"
        autocomplete="off"
        placeholder={'[{"name": "Ada", "age": 28}]'}
      ></textarea>
      <div class="pane-actions">
        <button type="button" class="btn btn-sm" id="btn-sample">Load sample</button>
        <button type="button" class="btn btn-sm" id="btn-clear">Clear</button>
      </div>
    </div>

    <div class="pane">
      <div class="pane-head">
        <label for="output">CSV</label>
        <span class="stat" id="output-stat" aria-live="polite"></span>
      </div>
      <textarea id="output" rows="14" readonly spellcheck="false" placeholder="CSV appears here as you type"></textarea>
      <div class="pane-actions">
        <button type="button" class="btn btn-primary btn-sm" id="btn-copy">Copy to clipboard</button>
        <button type="button" class="btn btn-sm" id="btn-download">Download .csv</button>
      </div>
      <p class="status-banner" id="status" hidden></p>
    </div>
  </div>

  <div class="options">
    <fieldset>
      <legend>Delimiter</legend>
      <div class="row">
        <label class="field">
          <span>Field separator</span>
          <select id="opt-delimiter">
            <option value=",">Comma (,)</option>
            <option value=";">Semicolon (;)</option>
            <option value="tab">Tab</option>
          </select>
        </label>
      </div>
    </fieldset>
  </div>

  <p class="tool-toast" id="toast" role="status" aria-live="polite" hidden></p>
</section>

<script src="./json-to-csv.client.ts"></script>
