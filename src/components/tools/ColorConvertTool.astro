---
/** HEX/RGB/HSL color converter. Behaviour in ./color-convert.client.ts */
---

<section class="tool card" id="tool" data-tool="color-converter">
  <div class="single">
    <div class="pane-head">
      <label for="input">Color (hex, rgb, or hsl)</label>
      <span class="stat" id="input-stat" aria-live="polite"></span>
    </div>
    <div class="color-input-row">
      <span class="swatch" id="swatch" hidden aria-hidden="true"></span>
      <textarea id="input" rows="1" spellcheck="false" autocomplete="off" placeholder="#3366ff"></textarea>
    </div>
    <div class="pane-actions">
      <button type="button" class="btn btn-sm" id="btn-paste">Paste</button>
      <button type="button" class="btn btn-sm" id="btn-sample">Load sample</button>
      <button type="button" class="btn btn-sm" id="btn-clear">Clear</button>
    </div>
  </div>

  <p class="status-banner" id="status" hidden></p>

  <div class="cc-grid" id="grid" hidden></div>

  <p class="muted cc-note" id="note" hidden>Click any result to copy it.</p>

  <p class="tool-toast" id="toast" role="status" aria-live="polite" hidden></p>
</section>

<script src="./color-convert.client.ts"></script>

<style>
  .single textarea { min-height: 44px; resize: none; }
  .color-input-row { display: flex; align-items: stretch; gap: 0.6rem; }
  .color-input-row textarea { flex: 1; }
  .swatch {
    display: block; width: 44px; height: 44px; border-radius: var(--radius-sm);
    border: 1px solid var(--border); flex: none; background-image:
      linear-gradient(45deg, #8884 25%, transparent 25%), linear-gradient(-45deg, #8884 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #8884 75%), linear-gradient(-45deg, transparent 75%, #8884 75%);
    background-size: 12px 12px; background-position: 0 0, 0 6px, 6px -6px, -6px 0;
  }
  .cc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.7rem; margin-top: 1rem; }
  .cc-grid :global(.cc-row.no-copy) { cursor: default; }
  .cc-grid :global(.cc-row.no-copy:hover), .cc-grid :global(.cc-row.no-copy:focus-visible) { border-color: var(--border); }
  .cc-grid :global(.v.pass) { color: var(--success); }
  .cc-grid :global(.v.fail) { color: var(--danger); }
  .cc-note { font-size: 0.85rem; margin-top: 0.75rem; }
</style>
