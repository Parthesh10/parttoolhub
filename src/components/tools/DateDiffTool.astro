---
/** Difference between two dates/times. Behaviour in ./date-diff.client.ts */
---

<section class="tool card" id="tool" data-tool="date-difference-calculator">
  <div class="tool-toolbar">
    <button type="button" class="btn btn-sm" id="btn-fullscreen" aria-pressed="false">⛶ Fullscreen</button>
  </div>
  <div class="options">
    <fieldset>
      <legend>Interpret as</legend>
      <div class="row">
        <label class="field">
          <span>When no time zone is given</span>
          <select id="opt-tz">
            <option value="utc">UTC</option>
            <option value="local">Local time (this browser)</option>
          </select>
        </label>
      </div>
    </fieldset>
  </div>

  <div class="dd-inputs">
    <div class="single">
      <div class="pane-head">
        <label for="input-start">Start</label>
      </div>
      <input id="input-start" type="text" spellcheck="false" autocomplete="off" placeholder="2025-01-15" />
    </div>
    <button type="button" class="btn btn-sm dd-swap" id="btn-swap" aria-label="Swap start and end">⇅</button>
    <div class="single">
      <div class="pane-head">
        <label for="input-end">End</label>
      </div>
      <input id="input-end" type="text" spellcheck="false" autocomplete="off" placeholder="2025-06-01" />
    </div>
  </div>

  <div class="pane-actions dd-actions">
    <button type="button" class="btn btn-sm" id="btn-now">Set end to now</button>
    <button type="button" class="btn btn-sm" id="btn-sample">Load sample</button>
    <button type="button" class="btn btn-sm" id="btn-clear">Clear</button>
  </div>

  <p class="status-banner" id="status" hidden></p>

  <div class="dd-result" id="result" hidden>
    <p class="dd-headline" id="headline"></p>
    <div class="ts-grid" id="grid"></div>
    <div class="pane-actions">
      <button type="button" class="btn btn-primary btn-sm" id="btn-copy">Copy result</button>
    </div>
  </div>

  <p class="tool-toast" id="toast" role="status" aria-live="polite" hidden></p>
</section>

<script src="./date-diff.client.ts"></script>

<style>
  .dd-inputs {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 0.75rem; margin-top: 1.25rem;
  }
  @media (max-width: 640px) { .dd-inputs { grid-template-columns: 1fr; } .dd-swap { justify-self: center; transform: rotate(90deg); } }
  .dd-inputs input {
    font: inherit; font-family: var(--mono); font-size: 0.95rem; color: var(--text); padding: 0.6rem 0.75rem;
    border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); width: 100%;
  }
  .dd-inputs input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .dd-swap { align-self: center; font-size: 1.1rem; line-height: 1; padding: 0.5rem 0.6rem; }
  .dd-actions { margin-top: 0.85rem; }
  .dd-result { margin-top: 1.25rem; }
  .dd-headline { font-size: 1.15rem; font-weight: 650; margin: 0 0 0.85rem; }
  .ts-grid { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin: 0 0 1rem; font-size: 0.9rem; }
  .ts-grid .item { display: flex; flex-direction: column; }
  .ts-grid .item .k { color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.03em; }
  .ts-grid .item .v { font-weight: 600; }
</style>
