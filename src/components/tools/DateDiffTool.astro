---
/**
 * Difference between two dates/times. Behaviour in ./date-diff.client.ts
 *
 * Redesign round 2 (REDESIGN-PROPOSALS.md §7): the span is drawn as a timeline with calendar
 * ticks and a "today" marker, common ranges are one-click chips, and the totals are one row of
 * click-to-copy values under the headline instead of a tile grid.
 */
---

<section class="tool card" id="tool" data-tool="date-difference-calculator">
  <div class="options">
    <fieldset>
      <legend>Interpret as</legend>
      <div class="row">
        <label class="field">
          <span>When no time zone is given</span>
          <select id="opt-tz">
            <option value="utc">UTC</option>
            <option value="local">Local time (this browser)</option>
          </select>
        </label>
      </div>
    </fieldset>
  </div>

  <div class="dd-inputs">
    <div class="single">
      <div class="pane-head">
        <label for="input-start">Start</label>
      </div>
      <input id="input-start" type="text" spellcheck="false" autocomplete="off" placeholder="2025-01-15" />
    </div>
    <button type="button" class="btn btn-sm dd-swap" id="btn-swap" aria-label="Swap start and end">⇅</button>
    <div class="single">
      <div class="pane-head">
        <label for="input-end">End</label>
      </div>
      <input id="input-end" type="text" spellcheck="false" autocomplete="off" placeholder="2025-06-01" />
    </div>
  </div>

  <div class="dd-quick" role="group" aria-label="Quick ranges">
    <span class="dd-quick-label">Quick:</span>
    <button type="button" class="chip" data-range="to-year-end">Until end of year</button>
    <button type="button" class="chip" data-range="from-year-start">Since start of year</button>
    <button type="button" class="chip" data-range="plus-30">Today + 30 days</button>
    <button type="button" class="chip" data-range="plus-90">Today + 90 days</button>
  </div>

  <div class="pane-actions dd-actions">
    <button type="button" class="btn btn-sm" id="btn-now">Set end to now</button>
    <button type="button" class="btn btn-sm" id="btn-sample">Load sample</button>
    <button type="button" class="btn btn-sm" id="btn-clear">Clear</button>
  </div>

  <p class="status-banner" id="status" hidden></p>

  <div class="dd-result" id="result" hidden>
    <p class="dd-headline" id="headline"></p>
    <div class="dd-timeline" id="timeline" aria-hidden="true">
      <div class="dd-bar"></div>
      <div class="dd-ticks" id="ticks"></div>
      <div class="dd-ends"><span id="tl-start"></span><span id="tl-end"></span></div>
    </div>
    <div class="dd-stats" id="grid"></div>
    <div class="pane-actions">
      <button type="button" class="btn btn-primary btn-sm" id="btn-copy">Copy result</button>
    </div>
  </div>

  <p class="tool-toast" id="toast" role="status" aria-live="polite" hidden></p>
</section>

<script src="./date-diff.client.ts"></script>

<style>
  .dd-inputs {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 0.75rem; margin-top: 1.25rem;
  }
  @media (max-width: 640px) { .dd-inputs { grid-template-columns: 1fr; } .dd-swap { justify-self: center; transform: rotate(90deg); } }
  .dd-inputs input {
    font: inherit; font-family: var(--mono); font-size: 0.95rem; color: var(--text); padding: 0.6rem 0.75rem;
    border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); width: 100%;
  }
  .dd-inputs input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .dd-swap { align-self: center; font-size: 1.1rem; line-height: 1; padding: 0.5rem 0.6rem; }
  .dd-actions { margin-top: 0.85rem; }
  .dd-result { margin-top: 1.25rem; }
  .dd-headline { font-size: 1.3rem; font-weight: 700; font-family: var(--font-display); margin: 0 0 0.9rem; }

  .dd-quick { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; margin-top: 0.9rem; }
  .dd-quick-label { font-size: 0.85rem; color: var(--text-muted); margin-right: 0.2rem; }
  .dd-quick .chip { font-family: var(--font); }

  /* Timeline: a bar spanning start to end, calendar ticks placed by percentage, and a "today"
     marker when today falls inside the span. Ticks and marker are built by the client script. */
  .dd-timeline { position: relative; padding: 1.6rem 0 0.2rem; margin: 0 0.5rem 1rem; }
  .dd-bar { height: 8px; border-radius: 999px; background: linear-gradient(90deg, var(--accent), var(--accent-2)); }
  .dd-ticks { position: absolute; left: 0; right: 0; top: 0; height: 2.6rem; }
  .dd-ticks :global(.dd-tick) {
    position: absolute; top: 1.35rem; width: 1px; height: 18px; background: var(--text-muted); transform: translateX(-50%);
  }
  .dd-ticks :global(.dd-tick span) {
    position: absolute; bottom: calc(100% + 2px); left: 50%; transform: translateX(-50%);
    font-size: 0.7rem; color: var(--text-muted); white-space: nowrap;
  }
  .dd-ticks :global(.dd-today) { background: var(--danger); width: 2px; height: 26px; top: 1.1rem; }
  .dd-ticks :global(.dd-today span) { color: var(--danger); font-weight: 700; }
  .dd-ends { display: flex; justify-content: space-between; gap: 1rem; margin-top: 0.4rem; font-family: var(--mono); font-size: 0.8rem; color: var(--text-muted); }

  .dd-stats { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 1rem; }
  .dd-stats :global(.dd-stat) {
    display: inline-flex; align-items: baseline; gap: 0.35rem; padding: 0.35rem 0.7rem; cursor: pointer;
    font: inherit; font-size: 0.88rem; color: var(--text); border: 1px solid var(--border); border-radius: 999px; background: var(--surface-2);
  }
  .dd-stats :global(.dd-stat:hover), .dd-stats :global(.dd-stat:focus-visible) { border-color: var(--accent); }
  .dd-stats :global(.dd-stat:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .dd-stats :global(.dd-stat b) { font-variant-numeric: tabular-nums; }
  .dd-stats :global(.dd-stat .k) { color: var(--text-muted); font-size: 0.8rem; }
  @media (pointer: coarse) { .dd-stats :global(.dd-stat) { min-height: 44px; } }
  .ts-grid { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin: 0 0 1rem; font-size: 0.9rem; }
</style>
