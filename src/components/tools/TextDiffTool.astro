---
/** Line + word diff of two texts, with optional basic syntax highlighting. Behaviour in ./text-diff.client.ts */
---

<section class="tool card" id="tool" data-tool="text-diff-checker">
  <div class="tool-toolbar">
    <button type="button" class="btn btn-sm" id="btn-fullscreen" aria-pressed="false">⛶ Fullscreen</button>
  </div>

  <div class="options">
    <fieldset>
      <legend>Diff mode</legend>
      <div class="row" role="group" aria-label="Line or word diff">
        <button type="button" class="btn btn-sm" id="mode-line" aria-pressed="true">Line diff</button>
        <button type="button" class="btn btn-sm" id="mode-word" aria-pressed="false">Word diff</button>
      </div>
    </fieldset>

    <fieldset>
      <legend>Syntax highlighting</legend>
      <div class="row">
        <label class="field">
          <span>Language</span>
          <select id="opt-lang">
            <option value="auto" selected>Auto-detect</option>
            <option value="plain">Plain text</option>
            <option value="javascript">JavaScript / TypeScript</option>
            <option value="python">Python</option>
            <option value="json">JSON</option>
            <option value="html">HTML / XML</option>
            <option value="css">CSS</option>
            <option value="sql">SQL</option>
            <option value="bash">Bash / Shell</option>
          </select>
        </label>
      </div>
    </fieldset>
  </div>

  <div class="panes">
    <div class="pane">
      <div class="pane-head">
        <label for="input-a">Original</label>
        <span class="stat" id="stat-a" aria-live="polite"></span>
      </div>
      <textarea id="input-a" rows="12" spellcheck="false" autocomplete="off" placeholder="Paste the original text or code…"></textarea>
      <div class="pane-actions">
        <button type="button" class="btn btn-sm" id="btn-paste-a">Paste</button>
      </div>
    </div>
    <div class="pane">
      <div class="pane-head">
        <label for="input-b">Changed</label>
        <span class="stat" id="stat-b" aria-live="polite"></span>
      </div>
      <textarea id="input-b" rows="12" spellcheck="false" autocomplete="off" placeholder="Paste the changed text or code…"></textarea>
      <div class="pane-actions">
        <button type="button" class="btn btn-sm" id="btn-paste-b">Paste</button>
      </div>
    </div>
  </div>

  <div class="pane-actions td-actions">
    <button type="button" class="btn btn-sm td-swap" id="btn-swap" aria-label="Swap original and changed">⇅</button>
    <button type="button" class="btn btn-sm" id="btn-sample">Load sample</button>
    <button type="button" class="btn btn-sm" id="btn-clear">Clear</button>
  </div>

  <p class="status-banner" id="status" hidden></p>

  <div class="diff-result" id="result" hidden>
    <p class="diff-stats" id="stats"></p>
    <div class="diff-view" id="diff-view"></div>
    <div class="pane-actions">
      <button type="button" class="btn btn-primary btn-sm" id="btn-copy">Copy result</button>
    </div>
  </div>

  <p class="tool-toast" id="toast" role="status" aria-live="polite" hidden></p>
</section>

<script src="./text-diff.client.ts"></script>

<style>
  .td-actions { margin-top: 0.85rem; }
  .td-swap { font-size: 1.1rem; line-height: 1; }
  @media (max-width: 640px) { .td-swap { transform: rotate(90deg); } }

  .diff-result { margin-top: 1.25rem; }
  .diff-stats { font-size: 0.9rem; color: var(--text-muted); margin: 0 0 0.6rem; }
  .diff-view {
    font-family: var(--mono); font-size: 0.88rem; line-height: 1.55; white-space: pre-wrap; word-break: break-word;
    border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface);
    max-height: 60vh; overflow: auto; padding: 0.5rem 0;
  }
  :global(.dl-line) { display: flex; padding: 0 0.75rem; }
  :global(.dl-gutter) { flex: 0 0 1.4em; color: var(--text-muted); user-select: none; }
  :global(.dl-text) { flex: 1; min-width: 0; }
  :global(.dl-del) { background: color-mix(in srgb, var(--danger) 12%, transparent); }
  :global(.dl-ins) { background: color-mix(in srgb, var(--success) 14%, transparent); }
  :global(.dw-del) { background: color-mix(in srgb, var(--danger) 30%, transparent); text-decoration: line-through; }
  :global(.dw-ins) { background: color-mix(in srgb, var(--success) 35%, transparent); }
  :global(.sx-keyword) { color: var(--accent); font-weight: 600; }
  :global(.sx-string) { color: var(--success); }
  :global(.sx-comment) { color: var(--text-muted); font-style: italic; }
  :global(.sx-number) { color: var(--accent-2); }
  :global(.sx-tag) { color: var(--accent-2); }
</style>
