---
/** Line + word diff of two texts, with optional basic syntax highlighting. Behaviour in ./text-diff.client.ts */
---

<section class="tool card" id="tool" data-tool="text-diff-checker">
  <div class="tool-toolbar">
    <button type="button" class="btn btn-sm" id="btn-fullscreen" aria-pressed="false">⛶ Fullscreen</button>
  </div>

  <div class="options">
    <fieldset>
      <legend>Diff mode</legend>
      <div class="row" role="group" aria-label="Line or word diff">
        <button type="button" class="btn btn-sm" id="mode-line" aria-pressed="true">Line diff</button>
        <button type="button" class="btn btn-sm" id="mode-word" aria-pressed="false">Word diff</button>
      </div>
    </fieldset>

    <fieldset id="view-fieldset">
      <legend>Layout</legend>
      <div class="row" role="group" aria-label="Side by side or unified">
        <button type="button" class="btn btn-sm" id="view-split" aria-pressed="true">Side by side</button>
        <button type="button" class="btn btn-sm" id="view-unified" aria-pressed="false">Unified</button>
      </div>
    </fieldset>

    <fieldset>
      <legend>Syntax highlighting</legend>
      <div class="row">
        <label class="field">
          <span>Language</span>
          <select id="opt-lang">
            <option value="auto" selected>Auto-detect</option>
            <option value="plain">Plain text</option>
            <option value="javascript">JavaScript / TypeScript</option>
            <option value="python">Python</option>
            <option value="json">JSON</option>
            <option value="html">HTML / XML</option>
            <option value="css">CSS</option>
            <option value="sql">SQL</option>
            <option value="bash">Bash / Shell</option>
          </select>
        </label>
      </div>
    </fieldset>
  </div>

  <div class="panes">
    <div class="pane">
      <div class="pane-head">
        <label for="input-a">Original</label>
        <span class="pane-tools">
          <span class="stat" id="stat-a" aria-live="polite"></span>
          <button type="button" class="btn btn-sm pane-paste" id="btn-paste-a" aria-label="Paste into Original"><svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4h6v3H9zM8 5.5H6.5A1.5 1.5 0 0 0 5 7v12.5A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V7a1.5 1.5 0 0 0-1.5-1.5H16" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg> Paste</button>
        </span>
      </div>
      <div class="code-wrap">
        <div class="gutter" id="gutter-a" aria-hidden="true"><span>1</span></div>
        <textarea id="input-a" rows="12" spellcheck="false" autocomplete="off" placeholder="Paste the original text or code…"></textarea>
      </div>
    </div>
    <div class="pane">
      <div class="pane-head">
        <label for="input-b">Changed</label>
        <span class="pane-tools">
          <span class="stat" id="stat-b" aria-live="polite"></span>
          <button type="button" class="btn btn-sm pane-paste" id="btn-paste-b" aria-label="Paste into Changed"><svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4h6v3H9zM8 5.5H6.5A1.5 1.5 0 0 0 5 7v12.5A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V7a1.5 1.5 0 0 0-1.5-1.5H16" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg> Paste</button>
        </span>
      </div>
      <div class="code-wrap">
        <div class="gutter" id="gutter-b" aria-hidden="true"><span>1</span></div>
        <textarea id="input-b" rows="12" spellcheck="false" autocomplete="off" placeholder="Paste the changed text or code…"></textarea>
      </div>
    </div>
  </div>

  <div class="pane-actions diff-bar td-actions" role="group" aria-label="Both inputs">
    <button type="button" class="btn btn-sm" id="btn-swap"><svg class="swap-icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h15m-4-4 4 4-4 4M20 16H5m4-4-4 4 4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg> Swap sides</button>
    <button type="button" class="btn btn-sm" id="btn-sample">Load sample</button>
    <button type="button" class="btn btn-sm" id="btn-clear">Clear both</button>
  </div>

  <p class="status-banner" id="status" hidden></p>

  <div class="diff-result" id="result" hidden>
    <div class="diff-head">
      <p class="diff-stats" id="stats"></p>
      <div class="diff-nav" id="diff-nav" hidden>
        <button type="button" class="btn btn-sm" id="btn-prev" aria-label="Previous change">↑</button>
        <span class="stat" id="nav-pos" aria-live="polite"></span>
        <button type="button" class="btn btn-sm" id="btn-next" aria-label="Next change">↓</button>
        <label class="diff-all"><input type="checkbox" id="opt-show-all" /> Show all lines</label>
      </div>
    </div>
    <div class="diff-view" id="diff-view"></div>
    <div class="pane-actions">
      <button type="button" class="btn btn-primary btn-sm" id="btn-copy">Copy result</button>
    </div>
  </div>

  <p class="tool-toast" id="toast" role="status" aria-live="polite" hidden></p>
</section>

<script src="./text-diff.client.ts"></script>

<style>

  .diff-result { margin-top: 1.25rem; }
  .diff-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; margin: 0 0 0.6rem; }
  .diff-stats { font-size: 0.9rem; color: var(--text-muted); margin: 0; }
  .diff-nav { display: flex; align-items: center; gap: 0.4rem; }
  .diff-nav[hidden] { display: none; }
  .diff-nav .stat { min-width: 5.5em; text-align: center; }
  .diff-all { display: inline-flex; align-items: center; gap: 0.35rem; margin-left: 0.6rem; font-size: 0.85rem; cursor: pointer; }
  .diff-all input { accent-color: var(--accent); }
  @media (pointer: coarse) { .diff-all { min-height: 44px; } }
  /* Side by side needs width; on a phone the unified view is the only layout. */
  @media (max-width: 760px) { #view-fieldset { display: none; } }
  .diff-view {
    font-family: var(--mono); font-size: 0.88rem; line-height: 1.55; white-space: pre-wrap; word-break: break-word;
    border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface);
    max-height: 60vh; overflow: auto; padding: 0.5rem 0; position: relative;
  }
  :global(.dl-line) { display: flex; padding: 0 0.75rem; }
  :global(.dl-gutter) { flex: 0 0 1.4em; color: var(--text-muted); user-select: none; }
  :global(.dl-text) { flex: 1; min-width: 0; }
  :global(.dl-del) { background: color-mix(in srgb, var(--danger) 12%, transparent); }
  :global(.dl-ins) { background: color-mix(in srgb, var(--success) 14%, transparent); }
  :global(.dw-del) { background: color-mix(in srgb, var(--danger) 30%, transparent); text-decoration: line-through; }
  :global(.dw-ins) { background: color-mix(in srgb, var(--success) 35%, transparent); }
  :global(.sx-keyword) { color: var(--accent); font-weight: 600; }
  :global(.sx-string) { color: var(--success); }
  :global(.sx-comment) { color: var(--text-muted); font-style: italic; }
  :global(.sx-number) { color: var(--accent-2); }
  :global(.sx-tag) { color: var(--accent-2); }
</style>
