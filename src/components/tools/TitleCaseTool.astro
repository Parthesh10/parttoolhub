---
/** Title/sentence/upper/lower case converter. Behaviour in ./title-case.client.ts */
---

<section class="tool card" id="tool" data-tool="title-case">
  <div class="tool-toolbar">
    <button type="button" class="btn btn-sm" id="btn-fullscreen" aria-pressed="false">⛶ Fullscreen</button>
  </div>
  <div class="panes">
    <div class="pane">
      <div class="pane-head">
        <label for="input">Paste your title or text</label>
        <span class="stat" id="input-stat" aria-live="polite">0 characters</span>
      </div>
      <div class="code-wrap">
        <div class="gutter" id="input-gutter" aria-hidden="true"><span>1</span></div>
        <textarea
          id="input"
          rows="10"
          spellcheck="false"
          placeholder={'the lord of the rings: the fellowship of the ring'}
        ></textarea>
      </div>
      <div class="pane-actions">
        <button type="button" class="btn btn-sm" id="btn-paste">Paste</button>
        <button type="button" class="btn btn-sm" id="btn-sample">Load sample</button>
        <button type="button" class="btn btn-sm" id="btn-clear">Clear</button>
      </div>
      <p class="muted drop-hint">Or drop a .txt file onto the box above.</p>
    </div>

    <div class="pane">
      <div class="pane-head">
        <label for="output">Result</label>
        <span class="stat" id="output-stat" aria-live="polite"></span>
      </div>
      <div class="code-wrap">
        <div class="gutter" id="output-gutter" aria-hidden="true"></div>
        <textarea id="output" rows="10" readonly spellcheck="false" placeholder="Converted text appears here as you type"></textarea>
      </div>
      <div class="pane-actions">
        <button type="button" class="btn btn-primary btn-sm" id="btn-copy">Copy to clipboard</button>
        <button type="button" class="btn btn-sm" id="btn-wrap" aria-pressed="false">No-wrap</button>
      </div>
    </div>
  </div>

  <div class="options">
    <fieldset>
      <legend>Case</legend>
      <div class="row">
        <label class="field">
          <span>Mode</span>
          <select id="opt-mode">
            <option value="title">Title Case</option>
            <option value="sentence">Sentence case</option>
            <option value="upper">UPPERCASE</option>
            <option value="lower">lowercase</option>
            <option value="capitalize">Capitalize Each Word</option>
            <option value="alternating">aLtErNaTiNg cAsE</option>
            <option value="toggle">tOGGLE cASE</option>
          </select>
        </label>
        <label class="field" id="style-field">
          <span>Title case style</span>
          <select id="opt-style">
            <option value="apa">APA</option>
            <option value="chicago">Chicago</option>
            <option value="ap">AP</option>
            <option value="mla">MLA</option>
          </select>
        </label>
      </div>
    </fieldset>

    <fieldset>
      <legend>Options</legend>
      <div class="checks">
        <label><input type="checkbox" id="opt-preserve" checked /> Keep acronyms and brand names (NASA, iPhone) as typed</label>
      </div>
    </fieldset>
  </div>

  <p class="tool-toast" id="toast" role="status" aria-live="polite" hidden></p>
</section>

<script src="./title-case.client.ts"></script>
