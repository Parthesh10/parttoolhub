---
/** Random password generator. Behaviour in ./password-generate.client.ts */
---

<section class="tool card" id="tool" data-tool="password-generator">
  <div class="options">
    <fieldset>
      <legend>Length</legend>
      <div class="row">
        <label class="field">
          <span>Characters</span>
          <input type="number" id="opt-length" value="16" min="1" max="128" step="1" inputmode="numeric" />
        </label>
      </div>
    </fieldset>

    <fieldset>
      <legend>Character types</legend>
      <div class="checks">
        <label><input type="checkbox" id="opt-uppercase" checked /> Uppercase (A-Z)</label>
        <label><input type="checkbox" id="opt-lowercase" checked /> Lowercase (a-z)</label>
        <label><input type="checkbox" id="opt-numbers" checked /> Numbers (0-9)</label>
        <label><input type="checkbox" id="opt-symbols" checked /> Symbols (!@#$…)</label>
      </div>
    </fieldset>

    <fieldset>
      <legend>Options</legend>
      <div class="checks">
        <label><input type="checkbox" id="opt-ambiguous" /> Exclude ambiguous characters (0, O, 1, l, I)</label>
      </div>
    </fieldset>

    <fieldset>
      <legend>Quantity</legend>
      <div class="row">
        <label class="field">
          <span>How many</span>
          <select id="opt-count">
            <option value="1">1</option>
            <option value="5">5</option>
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
          </select>
        </label>
      </div>
    </fieldset>
  </div>

  <div class="single">
    <div class="pane-head">
      <label for="output">Generated passwords</label>
      <span class="stat" id="output-stat" aria-live="polite"></span>
    </div>
    <textarea id="output" rows="10" readonly spellcheck="false"></textarea>
    <div class="pane-actions">
      <button type="button" class="btn btn-primary btn-sm" id="btn-generate">Generate</button>
      <button type="button" class="btn btn-sm" id="btn-copy">Copy to clipboard</button>
      <button type="button" class="btn btn-sm" id="btn-download">Download .txt</button>
    </div>
    <p class="status-banner" id="status" hidden></p>
  </div>

  <p class="tool-toast" id="toast" role="status" aria-live="polite" hidden></p>
</section>

<script src="./password-generate.client.ts"></script>

<style>
  #output { font-family: var(--mono); min-height: 220px; }
  #opt-length { max-width: 6rem; }
</style>
