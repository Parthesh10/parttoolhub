---
/**
 * Random password generator. Behaviour in ./password-generate.client.ts
 *
 * Redesign round 1 (REDESIGN-PROPOSALS.md §1): the password is the hero, not a line in a
 * textarea. One password shows large, character-type coloured, with a strength meter and a
 * plain-words guessing time; a batch shows as rows with their own copy buttons. The options
 * are one compact panel (length slider + field, type chips) instead of four fieldsets.
 */
---

<section class="tool card" id="tool" data-tool="password-generator">
  <div class="tool-toolbar">
    <button type="button" class="btn btn-sm" id="btn-fullscreen" aria-pressed="false">⛶ Fullscreen</button>
  </div>

  <div class="pw-hero">
    <div class="pw-display">
      <p class="pw-value" id="pw-value" aria-live="polite" aria-label="Generated password"></p>
      <div class="pw-list" id="pw-list" hidden></div>
      <div class="pw-hero-actions">
        <button type="button" class="btn btn-sm" id="btn-generate" aria-label="Generate new password">↻ New</button>
        <button type="button" class="btn btn-primary btn-sm" id="btn-copy">Copy</button>
      </div>
    </div>
    <div class="pw-meter" id="pw-meter" data-strength="very-strong" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
    </div>
    <p class="pw-meter-label" id="output-stat" aria-live="polite"></p>
    <p class="status-banner" id="status" hidden></p>
  </div>

  <div class="pw-controls">
    <div class="pw-length">
      <label for="opt-length-range">Length</label>
      <input type="range" id="opt-length-range" min="4" max="64" value="16" aria-describedby="length-hint" />
      <input type="number" id="opt-length" value="16" min="1" max="128" step="1" inputmode="numeric" aria-label="Length in characters" />
    </div>
    <p class="pw-hint muted" id="length-hint">Drag, or type any length from 1 to 128.</p>

    <div class="pw-chips" role="group" aria-label="Character types">
      <label class="toggle-chip"><input type="checkbox" id="opt-uppercase" checked /> A-Z</label>
      <label class="toggle-chip"><input type="checkbox" id="opt-lowercase" checked /> a-z</label>
      <label class="toggle-chip"><input type="checkbox" id="opt-numbers" checked /> 0-9</label>
      <label class="toggle-chip"><input type="checkbox" id="opt-symbols" checked /> !@#$</label>
      <label class="toggle-chip"><input type="checkbox" id="opt-ambiguous" /> No 0 O 1 l I</label>
    </div>

    <div class="pw-bottom">
      <label class="pw-count">
        <span>How many</span>
        <select id="opt-count">
          <option value="1">1</option>
          <option value="5">5</option>
          <option value="10">10</option>
          <option value="25">25</option>
          <option value="50">50</option>
          <option value="100">100</option>
        </select>
      </label>
      <button type="button" class="btn btn-sm" id="btn-download">Download .txt</button>
    </div>
  </div>

  <p class="tool-toast" id="toast" role="status" aria-live="polite" hidden></p>
</section>

<script src="./password-generate.client.ts"></script>

<style>
  /* --- The password ------------------------------------------------------ */
  .pw-hero { margin-bottom: 1.25rem; }
  .pw-display {
    display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.1rem;
    border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface-2);
  }
  .pw-value {
    flex: 1; min-width: 0; margin: 0; font-family: var(--mono); font-size: clamp(1.15rem, 2.6vw, 1.65rem);
    font-weight: 600; letter-spacing: 0.04em; line-height: 1.35; overflow-wrap: anywhere;
  }
  .pw-value[hidden] { display: none; }
  .pw-hero-actions { display: flex; gap: 0.5rem; flex: none; align-self: flex-start; }
  /* Character-type colours (spans built by the client script, hence :global): digits and symbols
     stand out from letters, so 0 vs O and 1 vs l can be told apart at a glance. */
  .pw-value :global(.pw-d), .pw-list :global(.pw-d) { color: var(--syn-number); }
  .pw-value :global(.pw-s), .pw-list :global(.pw-s) { color: var(--syn-key); }

  .pw-list { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.3rem; max-height: 46vh; overflow: auto; }
  .pw-list[hidden] { display: none; }
  .pw-list :global(.pw-row) { display: flex; align-items: center; gap: 0.6rem; }
  .pw-list :global(.pw-row code) {
    flex: 1; min-width: 0; font-size: 0.95rem; background: var(--surface); padding: 0.3rem 0.55rem; overflow-wrap: anywhere;
  }

  /* --- Strength meter ---------------------------------------------------- */
  .pw-meter { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.3rem; margin-top: 0.7rem; }
  .pw-meter span { height: 6px; border-radius: 999px; background: var(--border); transition: background 0.2s; }
  .pw-meter[data-strength="weak"] span:nth-child(-n + 1) { background: var(--danger); }
  .pw-meter[data-strength="fair"] span:nth-child(-n + 2) { background: var(--accent-2); }
  .pw-meter[data-strength="strong"] span:nth-child(-n + 3) { background: var(--success); }
  .pw-meter[data-strength="very-strong"] span { background: var(--success); }
  .pw-meter[data-strength="none"] span { background: var(--border); }
  .pw-meter-label { margin: 0.4rem 0 0; font-size: 0.875rem; color: var(--text-muted); }
  .pw-meter-label :global(strong) { color: var(--text); }

  /* --- Options ----------------------------------------------------------- */
  .pw-controls { border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.9rem 1rem; }
  .pw-length { display: grid; grid-template-columns: auto 1fr 5rem; align-items: center; gap: 0.85rem; }
  .pw-length label { font-weight: 650; }
  .pw-length input[type="range"] { width: 100%; accent-color: var(--accent); }
  .pw-length input[type="number"] {
    font: inherit; font-family: var(--mono); color: var(--text); padding: 0.4rem 0.5rem; width: 100%;
    border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface);
  }
  .pw-length input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .pw-hint { font-size: 0.8rem; margin: 0.3rem 0 0.8rem; }

  .pw-chips { display: flex; flex-wrap: wrap; gap: 0.45rem; }

  .pw-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; margin-top: 0.9rem; }
  .pw-count { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; color: var(--text-muted); }
  .pw-count select {
    font: inherit; color: var(--text); padding: 0.35rem 0.5rem; border: 1px solid var(--border);
    border-radius: var(--radius-sm); background: var(--surface);
  }
  .pw-count select:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

  @media (pointer: coarse) {
    .pw-count select, .pw-length input[type="number"] { min-height: 44px; }
  }
  @media (max-width: 520px) {
    .pw-display { flex-direction: column; align-items: stretch; }
    .pw-hero-actions { align-self: stretch; }
    .pw-hero-actions .btn { flex: 1; justify-content: center; }
    .pw-length { grid-template-columns: 1fr 5rem; }
    .pw-length label { grid-column: 1 / -1; }
  }
</style>
