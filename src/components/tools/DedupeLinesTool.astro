---
/** Remove duplicate lines. Behaviour in ./dedupe-lines.client.ts */
---

<section class="tool card" id="tool" data-tool="dedupe-lines">
  <div class="panes">
    <div class="pane">
      <div class="pane-head">
        <label for="input">Paste your list</label>
        <span class="stat" id="input-stat" aria-live="polite">0 lines</span>
      </div>
      <textarea
        id="input"
        rows="12"
        spellcheck="false"
        placeholder={'apple\nbanana\napple\ncherry'}
      ></textarea>
      <div class="pane-actions">
        <button type="button" class="btn btn-sm" id="btn-sample">Load sample</button>
        <button type="button" class="btn btn-sm" id="btn-clear">Clear</button>
      </div>
    </div>

    <div class="pane">
      <div class="pane-head">
        <label for="output">Unique lines</label>
        <span class="stat" id="output-stat" aria-live="polite">0 lines</span>
      </div>
      <textarea id="output" rows="12" readonly spellcheck="false" placeholder="Deduplicated list appears here as you type"></textarea>
      <div class="pane-actions">
        <button type="button" class="btn btn-primary btn-sm" id="btn-copy">Copy to clipboard</button>
        <button type="button" class="btn btn-sm" id="btn-download">Download .txt</button>
      </div>
    </div>
  </div>

  <div class="options">
    <fieldset>
      <legend>Matching</legend>
      <div class="checks">
        <label><input type="checkbox" id="opt-ignorecase" /> Ignore letter case</label>
        <label><input type="checkbox" id="opt-trim" checked /> Trim spaces before comparing</label>
        <label><input type="checkbox" id="opt-blank" checked /> Remove blank lines</label>
        <label><input type="checkbox" id="opt-onlydup" /> Keep only lines that had duplicates</label>
      </div>
    </fieldset>

    <fieldset>
      <legend>Which copy to keep</legend>
      <div class="row">
        <label class="field">
          <span>Keep</span>
          <select id="opt-keep">
            <option value="first">First occurrence</option>
            <option value="last">Last occurrence</option>
          </select>
        </label>
        <label class="field">
          <span>Sort result</span>
          <select id="opt-sort">
            <option value="none">Keep original order</option>
            <option value="az">A → Z</option>
            <option value="za">Z → A</option>
          </select>
        </label>
      </div>
    </fieldset>
  </div>

  <p class="tool-toast" id="toast" role="status" aria-live="polite" hidden></p>
</section>

<script src="./dedupe-lines.client.ts"></script>
