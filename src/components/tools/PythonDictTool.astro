---
/**
 * Python dict/list literal → JSON converter. Behaviour in ./python-dict.client.ts
 */
---

<section class="tool card" id="tool" data-tool="python-dict-to-json">
  <div class="tool-toolbar">
    <button type="button" class="btn btn-sm" id="btn-fullscreen" aria-pressed="false">⛶ Fullscreen</button>
  </div>
  <div class="panes">
    <div class="pane">
      <div class="pane-head">
        <label for="input">Paste a Python dict or list</label>
        <span class="stat" id="input-stat" aria-live="polite">0 characters</span>
      </div>
      <div class="code-wrap">
        <div class="gutter" id="input-gutter" aria-hidden="true"><span>1</span></div>
        <textarea
          id="input"
          rows="14"
          spellcheck="false"
          autocomplete="off"
          placeholder={"{'name': 'Ada', 'active': True, 'tags': ['admin', 'beta'], 'ref': None}"}
        ></textarea>
      </div>
      <div class="pane-actions">
        <button type="button" class="btn btn-sm" id="btn-paste">Paste</button>
        <button type="button" class="btn btn-sm" id="btn-sample">Load sample</button>
        <button type="button" class="btn btn-sm" id="btn-clear">Clear</button>
      </div>
      <p class="muted drop-hint">Or drop a .py/.txt file onto the box above.</p>
    </div>

    <div class="pane">
      <div class="pane-head">
        <label for="output">JSON</label>
        <span class="stat" id="output-stat" aria-live="polite"></span>
      </div>
      <div class="code-wrap">
        <div class="gutter" id="output-gutter" aria-hidden="true"></div>
        <textarea id="output" rows="14" readonly spellcheck="false" placeholder="Valid JSON appears here as you type"></textarea>
      </div>
      <div class="pane-actions">
        <button type="button" class="btn btn-primary btn-sm" id="btn-copy">Copy to clipboard</button>
        <button type="button" class="btn btn-sm" id="btn-download">Download .json</button>
        <button type="button" class="btn btn-sm" id="btn-wrap" aria-pressed="false">No-wrap</button>
      </div>
      <p class="status-banner" id="status" hidden></p>
    </div>
  </div>

  <div class="options">
    <fieldset>
      <legend>Indent</legend>
      <div class="row">
        <label class="field">
          <span>Spacing</span>
          <select id="opt-indent">
            <option value="2">2 spaces</option>
            <option value="4">4 spaces</option>
            <option value="tab">Tab</option>
            <option value="0">Minified</option>
          </select>
        </label>
      </div>
    </fieldset>

    <fieldset>
      <legend>Keys</legend>
      <div class="checks">
        <label><input type="checkbox" id="opt-sort" /> Sort keys alphabetically</label>
      </div>
    </fieldset>
  </div>

  <p class="tool-toast" id="toast" role="status" aria-live="polite" hidden></p>
</section>

<script src="./python-dict.client.ts"></script>
