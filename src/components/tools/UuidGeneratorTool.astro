---
/** UUID v4/v7 generator. Behaviour in ./uuid-generate.client.ts */
---

<section class="tool card" id="tool" data-tool="uuid-generator">
  <div class="options">
    <fieldset>
      <legend>Version</legend>
      <div class="row" role="group" aria-label="UUID version">
        <button type="button" class="btn btn-sm" id="ver-4" aria-pressed="true">Version 4 (random)</button>
        <button type="button" class="btn btn-sm" id="ver-7" aria-pressed="false">Version 7 (time-sortable)</button>
      </div>
    </fieldset>

    <fieldset>
      <legend>Quantity</legend>
      <div class="row">
        <label class="field">
          <span>How many</span>
          <select id="opt-count">
            <option value="1">1</option>
            <option value="5">5</option>
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
          </select>
        </label>
      </div>
    </fieldset>

    <fieldset>
      <legend>Format</legend>
      <div class="checks">
        <label><input type="checkbox" id="opt-uppercase" /> UPPERCASE</label>
        <label><input type="checkbox" id="opt-hyphens" checked /> Hyphens</label>
        <label><input type="checkbox" id="opt-braces" /> Wrap in {'{'} braces {'}'}</label>
      </div>
    </fieldset>
  </div>

  <div class="single">
    <div class="pane-head">
      <label for="output">Generated UUIDs</label>
      <span class="stat" id="output-stat" aria-live="polite"></span>
    </div>
    <textarea id="output" rows="10" readonly spellcheck="false"></textarea>
    <div class="pane-actions">
      <button type="button" class="btn btn-primary btn-sm" id="btn-generate">Generate</button>
      <button type="button" class="btn btn-sm" id="btn-copy">Copy to clipboard</button>
      <button type="button" class="btn btn-sm" id="btn-download">Download .txt</button>
    </div>
  </div>

  <p class="tool-toast" id="toast" role="status" aria-live="polite" hidden></p>
</section>

<script src="./uuid-generate.client.ts"></script>

<style>
  #ver-4[aria-pressed="true"], #ver-7[aria-pressed="true"] {
    background: var(--accent); border-color: var(--accent); color: #fff;
  }
  #output { font-family: var(--mono); min-height: 220px; }
</style>
