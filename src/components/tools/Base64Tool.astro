---
/** Base64 encode/decode. Behaviour in ./base64.client.ts */
---

<section class="tool card" id="tool" data-tool="base64">
  <div class="tool-toolbar">
    <button type="button" class="btn btn-sm" id="btn-fullscreen" aria-pressed="false">⛶ Fullscreen</button>
  </div>
  <div class="options">
    <fieldset>
      <legend>Direction</legend>
      <div class="row" role="group" aria-label="Encode or decode">
        <button type="button" class="btn btn-sm" id="mode-encode" aria-pressed="true">Encode</button>
        <button type="button" class="btn btn-sm" id="mode-decode" aria-pressed="false">Decode</button>
        <button type="button" class="btn btn-sm" id="btn-swap" title="Swap input and output, and flip direction">⇄ Swap</button>
      </div>
    </fieldset>
  </div>

  <div class="panes">
    <div class="pane">
      <div class="pane-head">
        <label for="input" id="input-label">Plain text</label>
        <span class="stat" id="input-stat" aria-live="polite">0 characters</span>
      </div>
      <div class="code-wrap">
        <div class="gutter" id="input-gutter" aria-hidden="true"><span>1</span></div>
        <textarea id="input" rows="10" spellcheck="false" autocomplete="off" placeholder="Hello, world!"></textarea>
      </div>
      <div class="pane-actions">
        <button type="button" class="btn btn-sm" id="btn-paste">Paste</button>
        <button type="button" class="btn btn-sm" id="btn-sample">Load sample</button>
        <button type="button" class="btn btn-sm" id="btn-clear">Clear</button>
      </div>
      <p class="muted drop-hint">Or drop a .txt file onto the box above.</p>
    </div>

    <div class="pane">
      <div class="pane-head">
        <label for="output" id="output-label">Base64</label>
        <span class="stat" id="output-stat" aria-live="polite"></span>
      </div>
      <div class="code-wrap">
        <div class="gutter" id="output-gutter" aria-hidden="true"></div>
        <textarea id="output" rows="10" readonly spellcheck="false"></textarea>
      </div>
      <div class="pane-actions">
        <button type="button" class="btn btn-primary btn-sm" id="btn-copy">Copy to clipboard</button>
        <button type="button" class="btn btn-sm" id="btn-wrap" aria-pressed="false">No-wrap</button>
      </div>
      <p class="status-banner" id="status" hidden></p>
    </div>
  </div>

  <div class="options" id="encode-options">
    <fieldset>
      <legend>Encoding options</legend>
      <div class="checks">
        <label><input type="checkbox" id="opt-urlsafe" /> URL-safe alphabet (- and _ instead of + and /)</label>
        <label><input type="checkbox" id="opt-nopad" /> Omit "=" padding</label>
      </div>
    </fieldset>
  </div>

  <p class="tool-toast" id="toast" role="status" aria-live="polite" hidden></p>
</section>

<script src="./base64.client.ts"></script>
<!-- Encode/Decode pressed-state color now comes from the global .btn[aria-pressed="true"] rule. -->
