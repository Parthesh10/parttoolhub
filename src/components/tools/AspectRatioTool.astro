---
/** Aspect ratio from width×height, plus a live width/height scale calculator. Behaviour in ./aspect-ratio.client.ts */
---

<section class="tool card" id="tool" data-tool="aspect-ratio-calculator">
  <div class="tool-toolbar">
    <button type="button" class="btn btn-sm" id="btn-fullscreen" aria-pressed="false">⛶ Fullscreen</button>
  </div>

  <div class="ar-inputs">
    <div class="single">
      <div class="pane-head">
        <label for="input-width">Width</label>
      </div>
      <input id="input-width" type="text" inputmode="decimal" spellcheck="false" autocomplete="off" placeholder="1920" />
    </div>
    <button type="button" class="btn btn-sm ar-swap" id="btn-swap" aria-label="Swap width and height">⇅</button>
    <div class="single">
      <div class="pane-head">
        <label for="input-height">Height</label>
      </div>
      <input id="input-height" type="text" inputmode="decimal" spellcheck="false" autocomplete="off" placeholder="1080" />
    </div>
  </div>

  <div class="pane-actions">
    <button type="button" class="btn btn-sm" id="btn-sample">Load sample</button>
    <button type="button" class="btn btn-sm" id="btn-clear">Clear</button>
  </div>

  <p class="status-banner" id="status" hidden></p>

  <div class="ar-result" id="result" hidden>
    <p class="ar-headline" id="headline"></p>
    <p class="muted ar-match" id="match"></p>
    <div class="ts-grid" id="grid"></div>
    <div class="pane-actions">
      <button type="button" class="btn btn-primary btn-sm" id="btn-copy">Copy result</button>
    </div>

    <div class="ar-scale">
      <h3>Scale to a new size</h3>
      <p class="muted ar-scale-hint">Type either one, and the other updates to keep the same ratio.</p>
      <div class="ar-inputs">
        <div class="single">
          <div class="pane-head"><label for="input-scale-width">New width</label></div>
          <input id="input-scale-width" type="text" inputmode="decimal" spellcheck="false" autocomplete="off" placeholder="1280" />
        </div>
        <span class="ar-times" aria-hidden="true">×</span>
        <div class="single">
          <div class="pane-head"><label for="input-scale-height">New height</label></div>
          <input id="input-scale-height" type="text" inputmode="decimal" spellcheck="false" autocomplete="off" placeholder="720" />
        </div>
      </div>
    </div>

    <div class="ar-resolutions">
      <h3>Common resolutions at this exact ratio</h3>
      <div class="cc-grid" id="res-grid"></div>
      <p class="muted cc-note">Click any resolution to copy it.</p>
    </div>
  </div>

  <p class="tool-toast" id="toast" role="status" aria-live="polite" hidden></p>
</section>

<script src="./aspect-ratio.client.ts"></script>

<style>
  .ar-inputs {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 0.75rem; margin-top: 1.25rem;
  }
  @media (max-width: 640px) { .ar-inputs { grid-template-columns: 1fr; } .ar-swap { justify-self: center; transform: rotate(90deg); } }
  .ar-inputs input {
    font: inherit; font-family: var(--mono); font-size: 0.95rem; color: var(--text); padding: 0.6rem 0.75rem;
    border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); width: 100%;
  }
  .ar-inputs input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .ar-swap { align-self: center; font-size: 1.1rem; line-height: 1; padding: 0.5rem 0.6rem; }
  .ar-times { align-self: center; color: var(--text-muted); font-family: var(--mono); }

  .ar-result { margin-top: 1.25rem; }
  .ar-headline { font-size: 1.6rem; font-weight: 700; font-family: var(--mono); margin: 0; }
  .ar-match { margin: 0.15rem 0 0.9rem; font-size: 0.9rem; }
  .ts-grid { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin: 0 0 1rem; font-size: 0.9rem; }

  .ar-scale, .ar-resolutions { margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
  .ar-scale h3, .ar-resolutions h3 { margin: 0 0 0.35rem; font-size: 1rem; }
  .ar-scale-hint { margin: 0 0 0.25rem; font-size: 0.85rem; }

  .cc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.6rem; margin-top: 0.75rem; }
  /* Resolution presets: a single centered value, unlike the shared label-over-value .cc-row. */
  .cc-grid :global(.cc-row) { align-items: center; justify-content: center; text-align: center; font-family: var(--mono); font-weight: 600; }
  .cc-note { font-size: 0.85rem; margin-top: 0.6rem; }
</style>
