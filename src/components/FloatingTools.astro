---
/**
 * Two floating controls, present on every page (rendered once from
 * Base.astro): a search FAB that opens a command-palette-style overlay for
 * jumping straight to any of the 24 tools, and a "back to top" FAB that
 * appears once you've scrolled. Both are frosted-glass, spring-eased —
 * iOS-control-center styling — and respect prefers-reduced-motion via the
 * same global `*` transition override every other animation on the site uses.
 *
 * The tool index is serialised at build time from the registry into a JSON
 * island (never hand-duplicated), so the palette can never list a tool that
 * doesn't exist or use a stale name.
 */
import { TOOLS, toolPath } from '../data/tools';
import { categoryBySlug } from '../data/categories';

export interface Props {
  /** Present only on tool pages; when set, a third "Share" FAB is rendered. */
  tool?: { slug: string; category: string };
}
const { tool } = Astro.props as Props;

const index = TOOLS.map((t) => ({
  name: t.name,
  short: t.short,
  category: categoryBySlug(t.category).name,
  href: toolPath(t),
}));
---

<div class="floating-tools" data-nav="floating">
  <button type="button" id="fab-top" class="fab fab-top" aria-label="Back to top" hidden>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 19V5M6 11l6-6 6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  {tool && (
    <div class="fab-share-wrap">
      <button type="button" id="fab-share" class="fab fab-share" aria-label="Share this tool" aria-haspopup="menu" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="18" cy="5" r="2.6" stroke="currentColor" stroke-width="2" />
          <circle cx="6" cy="12" r="2.6" stroke="currentColor" stroke-width="2" />
          <circle cx="18" cy="19" r="2.6" stroke="currentColor" stroke-width="2" />
          <path d="M8.4 10.7l7.2-4.4M8.4 13.3l7.2 4.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
      <div class="share-menu" id="share-menu" role="menu" hidden>
        <button type="button" id="share-copy" role="menuitem">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="9" y="9" width="11" height="11" rx="2" stroke="currentColor" stroke-width="2" />
            <path d="M5 15V6a1 1 0 0 1 1-1h9" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          Copy link
        </button>
        <button type="button" id="share-reddit" role="menuitem">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#FF4500" aria-hidden="true">
            <path d="M12 0C5.373 0 0 5.373 0 12c0 3.314 1.343 6.314 3.515 8.485l-2.286 2.286C.775 23.225 1.097 24 1.738 24H12c6.627 0 12-5.373 12-12S18.627 0 12 0Zm4.388 3.199c1.104 0 1.999.895 1.999 1.999 0 1.105-.895 2-1.999 2-.946 0-1.739-.657-1.947-1.539v.002c-1.147.162-2.032 1.15-2.032 2.341v.007c1.776.067 3.4.567 4.686 1.363.473-.363 1.064-.58 1.707-.58 1.547 0 2.802 1.254 2.802 2.802 0 1.117-.655 2.081-1.601 2.531-.088 3.256-3.637 5.876-7.997 5.876-4.361 0-7.905-2.617-7.998-5.87-.954-.447-1.614-1.415-1.614-2.538 0-1.548 1.255-2.802 2.803-2.802.645 0 1.239.218 1.712.585 1.275-.79 2.881-1.291 4.64-1.365v-.01c0-1.663 1.263-3.034 2.88-3.207.188-.911.993-1.595 1.959-1.595Zm-8.085 8.376c-.784 0-1.459.78-1.506 1.797-.047 1.016.64 1.429 1.426 1.429.786 0 1.371-.369 1.418-1.385.047-1.017-.553-1.841-1.338-1.841Zm7.406 0c-.786 0-1.385.824-1.338 1.841.047 1.017.634 1.385 1.418 1.385.785 0 1.473-.413 1.426-1.429-.046-1.017-.721-1.797-1.506-1.797Zm-3.703 4.013c-.974 0-1.907.048-2.77.135-.147.015-.241.168-.183.305.483 1.154 1.622 1.964 2.953 1.964 1.33 0 2.47-.81 2.953-1.964.057-.137-.037-.29-.184-.305-.863-.087-1.795-.135-2.769-.135Z"/>
          </svg>
          Share to Reddit
        </button>
      </div>
    </div>
  )}
  <button type="button" id="fab-search" class="fab fab-search" aria-label="Search tools" aria-haspopup="dialog">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2.2" />
      <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
    </svg>
    <span class="fab-kbd">⌘K</span>
  </button>
  <p class="fab-toast" id="fab-toast" role="status" hidden></p>
</div>

<div class="palette-backdrop" id="palette-backdrop" hidden>
  <div class="palette" role="dialog" aria-modal="true" aria-label="Search tools">
    <div class="palette-head">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2.2" />
        <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
      </svg>
      <input id="palette-input" type="text" placeholder={`Search ${TOOLS.length} tools…`} autocomplete="off" spellcheck="false" aria-label="Search tools" />
      <kbd class="palette-esc">Esc</kbd>
    </div>
    <ul id="palette-results" role="listbox" aria-label="Matching tools"></ul>
    <p class="palette-empty" id="palette-empty" hidden>No tools match. Try a different word.</p>
  </div>
</div>

<div class="palette-backdrop" id="shortcuts-backdrop" hidden>
  <div class="palette shortcuts-dialog" role="dialog" aria-modal="true" aria-label="Keyboard shortcuts">
    <div class="palette-head">
      <strong>Keyboard shortcuts</strong>
      <kbd class="palette-esc">Esc</kbd>
    </div>
    <dl class="shortcuts-list">
      <div><dt><kbd>Ctrl</kbd>/<kbd>⌘</kbd> + <kbd>K</kbd></dt><dd>Search tools</dd></div>
      <div><dt><kbd>Ctrl</kbd>/<kbd>⌘</kbd> + <kbd>Enter</kbd></dt><dd>Copy the result, on tools where that applies</dd></div>
      <div><dt><kbd>Esc</kbd></dt><dd>Close a dialog, or exit fullscreen</dd></div>
      <div><dt><kbd>?</kbd></dt><dd>Open this list</dd></div>
    </dl>
    <p class="shortcuts-note muted">Shown only when you're not typing in a field, so "?" still works normally in every tool's input.</p>
  </div>
</div>

<script type="application/json" id="tools-index" set:html={JSON.stringify(index)} />
<script src="./floating-tools.client.ts"></script>

<style>
  .floating-tools {
    position: fixed; right: 1.1rem; bottom: calc(1.1rem + env(safe-area-inset-bottom, 0px));
    display: flex; flex-direction: column; align-items: flex-end; gap: 0.6rem; z-index: 60;
    transition: transform 0.25s var(--ease-spring), opacity 0.2s;
  }
  /* Phones only (set by floating-tools.client.ts): slid off the bottom-right corner while
     scrolling down or typing, so they never sit on top of a tool's own buttons. */
  .floating-tools.is-tucked { transform: translateX(calc(100% + 1.5rem)); opacity: 0; pointer-events: none; }
  /* Frosted-glass FAB, iOS control-center style. */
  .fab {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem;
    height: 3rem; padding: 0 0.9rem; border-radius: 999px; border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    color: var(--text); cursor: pointer; box-shadow: var(--shadow-lg);
    transition: transform 0.18s var(--ease-spring), box-shadow 0.15s, background 0.15s, opacity 0.15s;
  }
  .fab-top { width: 3rem; padding: 0; }
  .fab-share { width: 3rem; padding: 0; }
  .fab:hover { background: var(--surface); }
  .fab:active { transform: scale(0.92); }
  .fab:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .fab[aria-expanded="true"] { background: var(--surface); }

  .fab-share-wrap { position: relative; }
  .share-menu {
    position: absolute; right: calc(100% + 0.6rem); bottom: 0; z-index: 61;
    display: flex; flex-direction: column; gap: 0.15rem; min-width: 168px; padding: 0.35rem;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(18px) saturate(180%);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    border: 1px solid var(--border); border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    animation: palette-in 0.16s var(--ease-spring);
  }
  .share-menu button {
    display: flex; align-items: center; gap: 0.55rem; width: 100%; text-align: left;
    padding: 0.55rem 0.65rem; border: 0; border-radius: var(--radius-sm); background: none;
    color: var(--text); font: inherit; font-size: 0.88rem; cursor: pointer;
    transition: background 0.12s;
  }
  .share-menu button:hover, .share-menu button:focus-visible { background: var(--surface-2); }
  /* Beside the button there's room on desktop, but not next to a screen edge on a
     phone — stack the menu above the FAB instead of to its side. */
  @media (max-width: 640px) { .share-menu { right: 0; bottom: calc(100% + 0.6rem); } }

  .fab-toast {
    position: absolute; right: 0; bottom: calc(100% + 0.6rem); z-index: 62;
    margin: 0; padding: 0.5rem 0.85rem; border-radius: var(--radius-sm);
    background: var(--text); color: var(--bg); font-size: 0.85rem; white-space: nowrap;
    box-shadow: var(--shadow-lg); animation: palette-in 0.16s var(--ease-spring);
  }
  .fab-kbd {
    font-family: var(--mono); font-size: 0.72rem; color: var(--text-muted);
    border: 1px solid var(--border); border-radius: 4px; padding: 0.05rem 0.35rem;
  }
  @media (max-width: 640px) { .fab-kbd { display: none; } .fab-search { width: 3rem; padding: 0; } }

  .palette-backdrop {
    position: fixed; inset: 0; z-index: 80;
    background: color-mix(in srgb, #000 45%, transparent);
    backdrop-filter: blur(3px);
    display: flex; align-items: flex-start; justify-content: center;
    padding: 12vh 1rem 1rem;
  }
  .palette {
    width: 100%; max-width: 560px; max-height: 70vh; display: flex; flex-direction: column;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(22px) saturate(180%);
    -webkit-backdrop-filter: blur(22px) saturate(180%);
    border: 1px solid var(--border); border-radius: calc(var(--radius) + 4px);
    box-shadow: var(--shadow-lg); overflow: hidden;
    animation: palette-in 0.22s var(--ease-spring);
  }
  @keyframes palette-in { from { opacity: 0; transform: translateY(-8px) scale(0.98); } to { opacity: 1; transform: none; } }
  .palette-head { display: flex; align-items: center; gap: 0.6rem; padding: 0.85rem 1rem; border-bottom: 1px solid var(--border); color: var(--text-muted); }
  #palette-input { flex: 1; border: 0; background: none; font: inherit; font-size: 1rem; color: var(--text); outline: none; }
  .palette-esc { font-family: var(--mono); font-size: 0.72rem; color: var(--text-muted); border: 1px solid var(--border); border-radius: 4px; padding: 0.1rem 0.4rem; }
  #palette-results { list-style: none; margin: 0; padding: 0.4rem; overflow-y: auto; }
  /* The <li>/<a>/spans below are injected client-side (floating-tools.client.ts builds
     the list from the JSON tools index), so Astro's automatic style scoping never reaches
     them — :global() is required here, not a stylistic choice. */
  #palette-results :global(li) { list-style: none; }
  #palette-results :global(li[role="option"]) { display: flex; align-items: stretch; gap: 0.15rem; }
  #palette-results :global(li a) {
    display: block; flex: 1; min-width: 0; padding: 0.55rem 0.7rem; border-radius: var(--radius-sm); color: var(--text);
  }
  /* UX-010: pin/unpin a tool without leaving the palette or navigating. */
  #palette-results :global(.r-star) {
    flex: none; width: 2.1rem; border: 0; background: none; border-radius: var(--radius-sm);
    color: var(--text-muted); font-size: 1.05rem; cursor: pointer; line-height: 1;
  }
  #palette-results :global(.r-star:hover) { background: var(--surface-2); color: var(--accent); }
  #palette-results :global(.r-star[aria-pressed="true"]) { color: var(--accent); }
  #palette-results :global(li a:hover),
  #palette-results :global(li[aria-selected="true"] a) { background: var(--surface-2); text-decoration: none; }
  #palette-results :global(.r-heading) {
    padding: 0.4rem 0.7rem 0.25rem; font-size: 0.72rem; font-weight: 650; text-transform: uppercase;
    letter-spacing: 0.04em; color: var(--text-muted);
  }
  #palette-results :global(.r-name) { font-weight: 650; }
  #palette-results :global(.r-meta) { color: var(--text-muted); font-size: 0.82rem; margin-left: 0.4rem; }
  #palette-results :global(.r-short) { display: block; color: var(--text-muted); font-size: 0.85rem; margin-top: 0.1rem; }
  .palette-empty { padding: 1.5rem 1rem; text-align: center; color: var(--text-muted); font-size: 0.9rem; }

  .shortcuts-dialog { max-height: none; }
  .shortcuts-dialog .palette-head { justify-content: space-between; }
  .shortcuts-list { margin: 0; padding: 0.5rem 1rem 0.2rem; }
  .shortcuts-list > div { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: 0.5rem 0; border-bottom: 1px solid var(--border); }
  .shortcuts-list > div:last-child { border-bottom: 0; }
  .shortcuts-list dt { display: flex; align-items: center; gap: 0.25rem; flex: none; }
  .shortcuts-list dd { margin: 0; color: var(--text-muted); font-size: 0.9rem; text-align: right; }
  .shortcuts-list kbd {
    font-family: var(--mono); font-size: 0.78rem; color: var(--text);
    border: 1px solid var(--border); border-radius: 4px; padding: 0.1rem 0.4rem; background: var(--surface-2);
  }
  .shortcuts-note { padding: 0.7rem 1rem 0.9rem; margin: 0; font-size: 0.8rem; }

  @media (pointer: coarse) { .fab { min-height: 44px; } }
</style>
