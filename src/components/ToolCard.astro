---
/**
 * One tool card, shared by the home page and the category hubs (UI round 3). The whole card is
 * clickable through a "stretched" link (the h3 link's ::after covers the card), which leaves room
 * for a separate favourite star: a button cannot sit inside a link, so the card itself is not an
 * <a>. The star state lives in localStorage (same list the command palette's stars use); the
 * script below paints it and announces changes as a `pth:favorites-changed` event so the home
 * page's "Your tools" row can follow without a reload.
 */
import type { Tool } from '../data/tools';
import { toolPath } from '../data/tools';
import { categoryTintVar } from '../lib/category-tint';
import ToolIcon from './ToolIcon.astro';

export interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
---

<article
  class="card tool-card"
  data-slug={tool.slug}
  data-category={tool.category}
  data-text={`${tool.name} ${tool.short}`.toLowerCase()}
  style={`--tint: ${categoryTintVar(tool.category)}`}
>
  <span class="tc-icon"><ToolIcon slug={tool.slug} size={20} /></span>
  <div class="tc-body">
    <h3><a class="tc-link" href={toolPath(tool)}>{tool.name}</a></h3>
    <p>{tool.short}</p>
  </div>
  <button type="button" class="tc-star" data-fav={tool.slug} data-name={tool.name} aria-pressed="false" aria-label={`Add ${tool.name} to favourites`}>
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9L12 16.9l-5.2 2.8 1-5.9-4.3-4.1 5.9-.8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
    </svg>
  </button>
</article>

<script>
  import { FAVORITE_TOOLS_KEY, toggleFavorite, parseFavorites } from '../lib/favorite-tools';

  function read(): string[] {
    try {
      return parseFavorites(localStorage.getItem(FAVORITE_TOOLS_KEY));
    } catch {
      return [];
    }
  }
  function paint() {
    const favs = read();
    document.querySelectorAll<HTMLButtonElement>('.tc-star').forEach((b) => {
      const on = favs.includes(b.dataset.fav ?? '');
      b.setAttribute('aria-pressed', String(on));
      b.setAttribute('aria-label', on ? `Remove ${b.dataset.name} from favourites` : `Add ${b.dataset.name} to favourites`);
    });
  }
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.tc-star');
    if (!b) return;
    e.preventDefault();
    const next = toggleFavorite(read(), b.dataset.fav ?? '');
    try {
      localStorage.setItem(FAVORITE_TOOLS_KEY, JSON.stringify(next));
    } catch {
      // Storage blocked: nothing to remember the star in.
    }
    paint();
    const added = next.includes(b.dataset.fav ?? '');
    window.pth?.track('tool_option', { option: 'favorite', value: added ? 'add' : 'remove' });
    document.dispatchEvent(new CustomEvent('pth:favorites-changed'));
  });
  // Another tab (or the command palette on this page) may change the list.
  window.addEventListener('storage', (e) => {
    if (e.key === FAVORITE_TOOLS_KEY) paint();
  });
  document.addEventListener('pth:favorites-changed', paint);
  paint();
</script>

<style>
  .tool-card {
    position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.85rem;
    align-items: start; padding: 1rem 2.6rem 1rem 1.05rem; border-top: 3px solid var(--tint);
    transition: border-color 0.15s, transform 0.15s var(--ease-spring), box-shadow 0.15s;
  }
  .tool-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    box-shadow: var(--shadow-lg), 0 0 0 1px color-mix(in srgb, var(--tint) 45%, transparent);
  }
  .tool-card:active { transform: scale(0.98); }
  .tc-icon {
    display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--tint) 14%, transparent); color: var(--tint);
    transition: transform 0.2s var(--ease-spring);
  }
  .tool-card:hover .tc-icon { transform: rotate(-6deg) scale(1.06); }
  h3 { margin: 0 0 0.3rem; font-size: 1.02rem; line-height: 1.3; }
  p { margin: 0; color: var(--text-muted); font-size: 0.88rem; }
  .tc-link { color: var(--text); }
  .tc-link:hover { text-decoration: none; }
  /* The link's hit area is the whole card. */
  .tc-link::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .tc-link:focus-visible { outline: none; }
  .tool-card:has(.tc-link:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .tc-star {
    position: absolute; top: 0.45rem; right: 0.45rem; z-index: 1; display: grid; place-items: center;
    width: 2rem; height: 2rem; padding: 0; border: 0; border-radius: 50%; cursor: pointer;
    background: none; color: var(--text-muted); fill: transparent;
    transition: color 0.15s, background 0.15s, transform 0.2s var(--ease-spring);
  }
  .tc-star:hover { background: var(--surface-2); color: var(--accent); }
  .tc-star:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .tc-star:active { transform: scale(0.85); }
  .tc-star[aria-pressed="true"] { color: var(--accent); fill: var(--accent); }
  .tc-star svg path { fill: inherit; }
  @media (pointer: coarse) { .tc-star { width: 44px; height: 44px; top: 0.2rem; right: 0.2rem; } .tool-card { padding-right: 3.2rem; } }
  @media (prefers-reduced-motion: reduce) { .tool-card:hover .tc-icon { transform: none; } }
</style>
