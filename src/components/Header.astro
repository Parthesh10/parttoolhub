---
/**
 * Header shows only Home + a category dropdown — never the full tool list —
 * per the nav rule: listing 50+ tools in the header dilutes focus and hurts
 * the content-to-clutter ratio. The dropdown is pure CSS (:focus-within /
 * hover), no JavaScript, matching "shared layout components must be pure
 * HTML/CSS with no JavaScript."
 */
import { SITE } from '../site.config';
import { CATEGORIES } from '../data/categories';
import { TOOLS } from '../data/tools';
import { visibleGuides } from '../lib/guides';
import { GUIDES_HUB } from '../data/guides';

const current = Astro.url.pathname;
// Shown once a guide exists (like the footer link), so the header never points at an empty section.
const hasGuides = (await visibleGuides()).length > 0;
const inGuides = current === GUIDES_HUB || current.startsWith(`${GUIDES_HUB}/`);
---

<header class="site-header" data-nav="header">
  <div class="container inner">
    <a class="brand" href="/" aria-label={`${SITE.name} home`}>
      <!-- A hex nut, not a generic document/clipboard glyph: "Part" (hardware) + "Tool" in
           one mark, distinctive enough to recognise at 22px in a tab. -->
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M20.6,12 16.3,19.45 7.7,19.45 3.4,12 7.7,4.55 16.3,4.55Z"
          stroke="currentColor" stroke-width="2" stroke-linejoin="round"
        />
        <circle cx="12" cy="12" r="3.1" stroke="currentColor" stroke-width="2" />
      </svg>
      <span>{SITE.name}</span>
    </a>
    <!-- Always-visible search (UI round 3): opens the command palette in FloatingTools, the same
         one Ctrl+K and the floating search button open. Desktop only; phones keep the floating
         button, since the header row has no room for a field there. -->
    <button type="button" class="header-search" data-open-palette aria-haspopup="dialog" aria-label="Search tools">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
        <path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <span class="hs-text">Search {TOOLS.length} tools…</span>
      <kbd class="hs-kbd" data-kbd>Ctrl K</kbd>
    </button>
    <div class="nav-group">
      <nav aria-label="Main">
        <ul>
          <li class="nav-home"><a href="/" aria-current={current === '/' ? 'page' : undefined}>Home</a></li>
          <li class="has-dropdown">
            <a href="/#tools" class="dropdown-trigger" aria-haspopup="true">
              Tools <span class="caret" aria-hidden="true">▾</span>
            </a>
            <ul class="dropdown">
              {CATEGORIES.map((c) => (
                <li><a href={`/${c.slug}`} aria-current={current === `/${c.slug}` ? 'page' : undefined}>{c.name}</a></li>
              ))}
            </ul>
          </li>
          {hasGuides && <li class="nav-guides"><a href={GUIDES_HUB} aria-current={inGuides ? 'page' : undefined}>Guides</a></li>}
        </ul>
      </nav>
      <div class="palette-wrap">
        <button type="button" id="palette-btn" class="theme-toggle" aria-haspopup="menu" aria-expanded="false" aria-controls="palette-menu" aria-label="Colour scheme">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 3a9 9 0 1 0 0 18c1.1 0 1.8-.8 1.8-1.7 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-1 .8-1.7 1.8-1.7H17a4 4 0 0 0 4-4C21 6.6 17 3 12 3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
            <circle cx="7.5" cy="11.5" r="1.3" fill="currentColor" />
            <circle cx="10" cy="7.5" r="1.3" fill="currentColor" />
            <circle cx="15" cy="7.5" r="1.3" fill="currentColor" />
          </svg>
          <span class="palette-dot" aria-hidden="true"></span>
        </button>
        <div class="palette-menu" id="palette-menu" role="menu" aria-label="Colour scheme" hidden>
          {[
            ['tangerine', 'Tangerine', 'Default', '#ff9a52', '#6cc4ff'],
            ['indigo', 'Indigo', 'Deep violet', '#a996ff', '#ffab70'],
            ['mint', 'Mint', 'Calm graphite', '#4fd8a8', '#ff8fa3'],
            ['cobalt', 'Cobalt', 'The original', '#7c93ff', '#f0a53d'],
          ].map(([id, name, note, a, b]) => (
            <button type="button" role="menuitemradio" aria-checked="false" data-palette={id} class="palette-item">
              <span class="sw" aria-hidden="true"><i style={`background:${a}`}></i><i style={`background:${b}`}></i></span>
              <span class="pi-text"><span class="pi-name">{name}</span><span class="pi-note">{note}</span></span>
              <span class="pi-check" aria-hidden="true">✓</span>
            </button>
          ))}
        </div>
      </div>
      <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Toggle color theme">
        <svg class="icon icon-light" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <svg class="icon icon-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        </svg>
        <svg class="icon icon-system" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3" y="4" width="18" height="13" rx="2" stroke="currentColor" stroke-width="2" />
          <path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const KEY = 'theme';
  type Mode = 'light' | 'dark' | 'system';
  const NEXT: Record<Mode, Mode> = { light: 'dark', dark: 'system', system: 'light' };
  const LABEL: Record<Mode, string> = {
    light: 'Theme: Light. Click to switch to Dark.',
    dark: 'Theme: Dark. Click to switch to System default.',
    system: 'Theme: System default. Click to switch to Light.',
  };

  const btn = document.getElementById('theme-toggle') as HTMLButtonElement;
  const themeColorMeta = document.querySelector('meta[name="theme-color"]');
  /** Browser-chrome colour follows whatever --surface the current theme + palette resolve to. */
  function syncThemeColor() {
    const surface = getComputedStyle(document.documentElement).getPropertyValue('--surface').trim();
    if (surface) themeColorMeta?.setAttribute('content', surface);
  }

  function currentMode(): Mode {
    const stored = localStorage.getItem(KEY);
    return stored === 'light' || stored === 'system' ? stored : 'dark';
  }

  function apply(mode: Mode) {
    if (mode === 'system') {
      document.documentElement.removeAttribute('data-theme');
    } else {
      document.documentElement.setAttribute('data-theme', mode);
    }
    btn.dataset.mode = mode;
    btn.setAttribute('aria-label', LABEL[mode]);

    syncThemeColor();
  }

  apply(currentMode());

  btn.addEventListener('click', () => {
    const next = NEXT[currentMode()];
    localStorage.setItem(KEY, next);
    apply(next);
  });

  // --- Colour palette picker (UI round 3) ----------------------------------------------------
  // Same pattern as the theme: localStorage 'palette', applied as data-palette on <html> (the
  // pre-paint script in Base.astro restores it before first paint). Tangerine is the default and
  // is represented by no attribute. global.css holds the palettes; tests/palette-contrast.test.ts
  // checks them.
  type Palette = 'tangerine' | 'indigo' | 'mint' | 'cobalt';
  const PALETTES: Palette[] = ['tangerine', 'indigo', 'mint', 'cobalt'];
  const paletteBtn = document.getElementById('palette-btn') as HTMLButtonElement;
  const paletteMenu = document.getElementById('palette-menu') as HTMLElement;
  const items = [...paletteMenu.querySelectorAll<HTMLButtonElement>('[data-palette]')];

  function currentPalette(): Palette {
    try {
      const p = localStorage.getItem('palette');
      return (PALETTES as string[]).includes(p ?? '') ? (p as Palette) : 'tangerine';
    } catch {
      return 'tangerine';
    }
  }
  function applyPalette(p: Palette) {
    if (p === 'tangerine') document.documentElement.removeAttribute('data-palette');
    else document.documentElement.setAttribute('data-palette', p);
    for (const it of items) it.setAttribute('aria-checked', String(it.dataset.palette === p));
    syncThemeColor();
  }
  function setMenu(open: boolean) {
    paletteMenu.hidden = !open;
    paletteBtn.setAttribute('aria-expanded', String(open));
    if (!open) return;
    // Anchored to the button's right edge; when the header wraps on a phone the button sits
    // further left, so nudge the menu back inside the viewport (8px margin) if it spills.
    paletteMenu.style.right = '';
    const r = paletteMenu.getBoundingClientRect();
    if (r.left < 8) paletteMenu.style.right = `${r.left - 8}px`;
    else if (r.right > window.innerWidth - 8) paletteMenu.style.right = `${r.right - (window.innerWidth - 8)}px`;
    (items.find((it) => it.getAttribute('aria-checked') === 'true') ?? items[0]).focus();
  }
  applyPalette(currentPalette());

  paletteBtn.addEventListener('click', () => setMenu(paletteMenu.hidden));
  for (const it of items) {
    it.addEventListener('click', () => {
      const p = it.dataset.palette as Palette;
      try {
        localStorage.setItem('palette', p);
      } catch {
        // Storage blocked: the choice still applies to this page view.
      }
      applyPalette(p);
      window.pth?.track('palette_change', { palette: p });
      setMenu(false);
      paletteBtn.focus();
    });
  }
  paletteMenu.addEventListener('keydown', (e) => {
    const i = items.indexOf(document.activeElement as HTMLButtonElement);
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      items[(i + (e.key === 'ArrowDown' ? 1 : items.length - 1)) % items.length].focus();
    } else if (e.key === 'Escape') {
      setMenu(false);
      paletteBtn.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (!paletteMenu.hidden && !(e.target as HTMLElement).closest('.palette-wrap')) setMenu(false);
  });
</script>

<style>
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    position: sticky; top: 0; z-index: 50;
  }
  .inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 58px; flex-wrap: wrap; }
  .brand { display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; letter-spacing: -0.01em; color: var(--text); }
  .brand:hover { text-decoration: none; color: var(--accent); }
  /* The mark is a hex nut — turning it on hover reads as "tool," not just decoration. */
  .brand svg { transition: transform 0.4s var(--ease-spring); }
  .brand:hover svg { transform: rotate(30deg); }
  .brand:active svg { transform: rotate(30deg) scale(0.9); }
  .nav-group { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
  nav > ul { list-style: none; display: flex; gap: 0.25rem; margin: 0; padding: 0; }
  nav > ul > li > a {
    display: block; padding: 0.4rem 0.7rem; border-radius: var(--radius-sm);
    color: var(--text-muted); font-weight: 500; font-size: 0.925rem;
  }
  nav > ul > li > a:hover { background: var(--surface-2); color: var(--text); text-decoration: none; }
  nav > ul > li > a[aria-current="page"] { background: var(--accent-soft); color: var(--accent); }

  .has-dropdown { position: relative; }
  .caret { font-size: 0.7em; }
  .dropdown {
    list-style: none; margin: 0; padding: 0.4rem;
    position: absolute; top: 100%; right: 0;
    width: max-content; min-width: 220px; max-width: calc(100vw - 2rem);
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
    opacity: 0; visibility: hidden; transform: translateY(-4px);
    transition: opacity 0.12s, transform 0.12s, visibility 0.12s;
  }
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1; visibility: visible; transform: translateY(0);
  }
  .dropdown a { display: block; padding: 0.5rem 0.6rem; border-radius: var(--radius-sm); color: var(--text); font-size: 0.9rem; }
  .dropdown a:hover { background: var(--surface-2); text-decoration: none; }
  .dropdown a[aria-current="page"] { color: var(--accent); font-weight: 600; }

  .theme-toggle {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.1rem; height: 2.1rem; padding: 0; margin-left: 0.25rem;
    border: 1px solid var(--border); border-radius: var(--radius-sm);
    background: var(--surface); color: var(--text-muted); cursor: pointer;
  }
  .theme-toggle:hover { background: var(--surface-2); color: var(--text); }
  .theme-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .theme-toggle .icon { display: none; }

  .header-search {
    /* Starts at 160px and grows to 340px: a fixed 340px basis made the whole header wrap to two
       rows between 761 and ~800px (tablets), since a wrapping flex row moves an item that doesn't
       fit instead of shrinking it. */
    display: none; align-items: center; gap: 0.55rem; flex: 1 1 160px; max-width: 340px; min-width: 0; margin-inline: auto;
    padding: 0.42rem 0.6rem 0.42rem 0.75rem; cursor: pointer; font: inherit; font-size: 0.9rem; text-align: left;
    color: var(--text-muted); background: var(--surface-2); border: 1px solid var(--border); border-radius: 999px;
    transition: border-color 0.15s, color 0.15s;
  }
  .header-search:hover { border-color: var(--accent); color: var(--text); }
  .header-search:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .hs-text { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hs-kbd {
    font-family: var(--mono); font-size: 0.72rem; padding: 0.1rem 0.4rem; border-radius: 4px;
    border: 1px solid var(--border); background: var(--surface); color: var(--text-muted);
  }
  @media (min-width: 761px) { .header-search { display: inline-flex; } }

  /* Colour palette picker. The dot under the icon shows the active accent. */
  .palette-wrap { position: relative; }
  #palette-btn { position: relative; }
  .palette-dot {
    position: absolute; right: 5px; bottom: 5px; width: 8px; height: 8px; border-radius: 50%;
    background: var(--accent); box-shadow: 0 0 0 2px var(--surface);
  }
  .palette-menu {
    position: absolute; top: calc(100% + 6px); right: 0; z-index: 60; min-width: 220px; padding: 0.35rem;
    display: grid; gap: 2px; background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); box-shadow: var(--shadow-lg);
  }
  .palette-menu[hidden] { display: none; }
  .palette-item {
    display: flex; align-items: center; gap: 0.7rem; width: 100%; padding: 0.5rem 0.6rem; text-align: left;
    font: inherit; color: var(--text); background: none; border: 0; border-radius: var(--radius-sm); cursor: pointer;
  }
  .palette-item:hover, .palette-item:focus-visible { background: var(--surface-2); outline: none; }
  .palette-item:focus-visible { box-shadow: inset 0 0 0 2px var(--accent); }
  .sw { display: inline-flex; flex: none; }
  .sw i { width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--surface); display: block; }
  .sw i + i { margin-left: -7px; }
  .pi-text { display: grid; line-height: 1.25; flex: 1; }
  .pi-name { font-weight: 600; font-size: 0.9rem; }
  .pi-note { font-size: 0.75rem; color: var(--text-muted); }
  .pi-check { color: var(--accent); font-weight: 700; visibility: hidden; }
  .palette-item[aria-checked="true"] .pi-check { visibility: visible; }
  @media (pointer: coarse) { .palette-item { min-height: 44px; } }
  /* Phones: the logo already links home, so the Home item goes to keep the header on one row
     now that it holds the palette picker as well as the theme toggle. */
  @media (max-width: 480px) { .nav-home { display: none; } }
  /* Guides costs ~68px, far more than a phone header has spare (about 10px at 360px with touch
     targets), and it wrapped the header at 481px where Home comes back. Up to 500px, phones reach
     guides from the footer, breadcrumbs and tool pages. Re-measure with touch emulation if you move this. */
  @media (max-width: 500px) { .nav-guides { display: none; } }
  .theme-toggle[data-mode="light"] .icon-light,
  .theme-toggle[data-mode="dark"] .icon-dark,
  .theme-toggle[data-mode="system"] .icon-system { display: block; }

  @media (max-width: 640px) {
    .inner { padding-block: 0.5rem; }
  }

  /* Touch devices: 44 px minimum tap targets for the nav links and the theme toggle. */
  @media (pointer: coarse) {
    nav > ul > li > a, .dropdown a { min-height: 44px; display: flex; align-items: center; }
    .theme-toggle { width: 44px; height: 44px; }
  }

  /* Narrow phones: logo + Tools + two 44px buttons must fit one row. At 360px (a very common
     Android width) it missed by 1px and the header doubled to 106px; tighter gaps, a slightly
     smaller wordmark and less padding on Tools buy ~30px, and at <=340px the caret goes too. */
  @media (max-width: 420px) {
    .inner { gap: 0.6rem; }
    .brand { font-size: 1.02rem; gap: 0.4rem; }
    .nav-group { gap: 0.25rem; }
    nav > ul > li > a { padding-inline: 0.5rem; }
  }
  @media (max-width: 340px) {
    .caret { display: none; }
    .brand { font-size: 0.95rem; }
  }
</style>
