---
/**
 * Category hub, e.g. /converters. One per entry in src/data/categories.ts.
 * Opens with 1–2 paragraphs on when you'd reach for this family of tools and
 * which one to use for what (seo-rules §3.4 — a hub with only cards is a thin
 * page), then lists every tool in the category with a one-line description.
 * Every tool is reachable in one click from here and two from home.
 */
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { CATEGORIES, categoryBySlug } from '../data/categories';
import { toolsInCategory, toolPath } from '../data/tools';
import { canonicalUrl } from '../lib/urls';
import { WEBSITE_ID } from '../lib/schema';
import { categoryTintVar } from '../lib/category-tint';
import CategoryIcon from '../components/CategoryIcon.astro';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug } }));
}

const { category: slug } = Astro.params;
const category = categoryBySlug(slug!);
const tools = toolsInCategory(category.slug);
const tint = categoryTintVar(category.slug);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: category.name,
    description: category.description,
    url: canonicalUrl(`/${category.slug}`),
    inLanguage: 'en',
    isPartOf: { '@id': WEBSITE_ID },
    // The visible list of tools, so the schema describes exactly what is on the page.
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: tools.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: t.name,
        url: canonicalUrl(toolPath(t)),
      })),
    },
  },
];
---

<Base title={category.name} description={category.description} schema={schema}>
  <Breadcrumbs items={[{ label: category.name }]} />

  <header class="hero bg-grid" style={`--tint: ${tint}`}>
    <p class="eyebrow">{tools.length} tool{tools.length === 1 ? '' : 's'} in this category</p>
    <h1><span class="icon-chip" aria-hidden="true"><CategoryIcon slug={category.slug} size={24} /></span>{category.name}</h1>
    <p class="lead">{category.blurb}</p>
  </header>

  <div class="prose intro">
    {category.intro.map((p) => <p set:html={p} />)}
  </div>

  <h2 class="grid-heading">Tools in this category</h2>
  <div class="grid" data-nav="hub-cards" style={`--tint: ${tint}`}>
    {tools.map((t) => (
      <a class="card tool-card" href={toolPath(t)}>
        <h3>{t.name}</h3>
        <p>{t.short}</p>
        <span class="cta">Open tool →</span>
      </a>
    ))}
  </div>
</Base>

<style>
  .hero { max-width: 72ch; margin-bottom: 1.75rem; padding-top: 0.25rem; }
  .hero .eyebrow { color: var(--tint); }
  .hero .eyebrow::before { background: var(--tint); }
  .hero h1 { display: flex; align-items: center; gap: 0.7rem; }
  .icon-chip {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.5rem; height: 2.5rem; border-radius: var(--radius-sm); flex: none;
    background: color-mix(in srgb, var(--tint) 14%, transparent);
    color: var(--tint);
  }
  .lead { font-size: 1.1rem; color: var(--text-muted); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; }
  .tool-card {
    display: flex; flex-direction: column; padding: 1.25rem 1.4rem; color: var(--text);
    border-top: 3px solid var(--tint);
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  .tool-card:hover {
    text-decoration: none; transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    box-shadow: var(--shadow-lg), 0 0 0 1px color-mix(in srgb, var(--tint) 45%, transparent);
  }
  .intro { margin-bottom: 1.75rem; }
  .grid-heading { font-size: 1.2rem; margin: 0 0 0.85rem; }
  .tool-card h3 { margin: 0 0 0.4rem; font-size: 1.1rem; }
  .tool-card p { color: var(--text-muted); font-size: 0.95rem; flex: 1; }
  .cta { color: var(--tint); font-weight: 600; font-size: 0.9rem; }
</style>
