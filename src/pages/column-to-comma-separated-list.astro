---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ColumnToListTool from '../components/ColumnToListTool.astro';
import AdSlot from '../components/AdSlot.astro';
import Faq from '../components/Faq.astro';
import { canonicalUrl } from '../lib/urls';
import { columnToList, PRESETS } from '../lib/list-convert';

const title = 'Column to Comma Separated List Converter';
const description =
  'Turn a column of values into a comma separated list instantly. Choose any separator, wrap items in quotes, remove duplicates, sort, and copy — all in your browser, nothing uploaded.';

// Every example below is generated by the real engine, so docs and behaviour can't drift.
const sample = 'apple\nbanana\ncherry';
const examples = PRESETS.map((p) => ({ ...p, output: columnToList(sample, p.options).output }));
const idSample = '1042\n1043\n1044';
const sqlExample = columnToList(idSample, { delimiter: ', ' }).output;

const faq = [
  {
    q: 'Is my data uploaded anywhere?',
    a: 'No. The conversion runs entirely in your browser with JavaScript. Nothing you paste is sent to a server, stored, or logged. You can disconnect from the internet after the page loads and it will keep working.',
  },
  {
    q: 'How do I put quotes around each value?',
    a: 'Type a quote character into both the <em>Before</em> and <em>After</em> boxes under “Wrap each item”, or click the <strong>SQL IN</strong>, <strong>JSON array</strong> or <strong>Python list</strong> preset, which fills those boxes for you.',
  },
  {
    q: 'Can I use a separator other than a comma?',
    a: 'Yes. The separator menu includes semicolon, pipe, space, tab and new line. Pick <em>Custom…</em> to type anything else, such as <code>--</code> or <code> :: </code>.',
  },
  {
    q: 'Why does the item count say some lines were dropped?',
    a: 'Blank lines are skipped by default, and duplicates are removed when that option is ticked. The counter tells you how many lines did not make it into the output so nothing disappears silently. Untick “Skip blank lines” to keep them.',
  },
  {
    q: 'Does it work with data copied from Excel or Google Sheets?',
    a: 'Yes. Select a column in your spreadsheet, copy it, and paste here. Each cell becomes one line, which is exactly what the converter expects. Trailing spaces from cells are trimmed automatically.',
  },
  {
    q: 'Is there a limit on how many lines I can convert?',
    a: 'There is no hard limit. Tens of thousands of lines convert in a fraction of a second because the work happens locally rather than over a network.',
  },
  {
    q: 'How do I go the other way — from a comma list back into a column?',
    a: 'Use the companion <a href="/comma-separated-list-to-column">comma separated list to column</a> tool, or click <em>Use as input</em> here to feed the result back in with a new-line separator.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: title,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any (web browser)',
    url: canonicalUrl(Astro.url.pathname),
    description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: [
      'Custom separators',
      'Quote or wrap each item',
      'Wrap the whole list',
      'Remove duplicates',
      'Sort alphabetically or numerically',
      'Change letter case',
      'One-click presets for SQL, JSON and Python',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to convert a column into a comma separated list',
    step: [
      { '@type': 'HowToStep', name: 'Paste', text: 'Copy a column from a spreadsheet, database result or text file and paste it into the left box.' },
      { '@type': 'HowToStep', name: 'Choose a format', text: 'Pick a separator, or click a preset such as SQL IN or JSON array to set the separator and wrappers at once.' },
      { '@type': 'HowToStep', name: 'Copy', text: 'The result updates as you type. Click Copy to clipboard or Download .txt.' },
    ],
  },
];
---

<Base {title} {description} {schema}>
  <Breadcrumbs items={[{ label: 'Column to Comma Separated List' }]} />

  <header class="hero">
    <h1>Column to Comma Separated List</h1>
    <p class="lead">
      Paste a column of values — one per line — and get them back as a single comma separated line.
      Add quotes, switch the separator, drop duplicates, sort, and copy. It all happens in your browser.
    </p>
  </header>

  <ColumnToListTool />

  <AdSlot slot="toolTop" format="horizontal" />

  <article class="prose">
    <h2>How to use this converter</h2>
    <ol>
      <li><strong>Paste your column.</strong> It can come from Excel, Google Sheets, a SQL query result, a log file or any text editor. Each line is treated as one item.</li>
      <li><strong>Pick an output shape.</strong> Use the preset chips for the common cases, or set the separator and wrappers by hand in the options panel.</li>
      <li><strong>Tidy the list if you need to.</strong> Remove duplicates, sort A–Z or numerically, change the letter case, or reverse the order.</li>
      <li><strong>Copy or download.</strong> The result box updates instantly; press <kbd>Ctrl</kbd>+<kbd>Enter</kbd> in the input box to copy without reaching for the mouse.</li>
    </ol>

    <h2>What the presets produce</h2>
    <p>
      Starting from the three-line column <code>apple</code>, <code>banana</code>, <code>cherry</code>, each preset gives you a
      different, ready-to-paste result:
    </p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Preset</th><th>Output</th><th>Typical use</th></tr></thead>
        <tbody>
          {examples.map((e) => (
            <tr>
              <td><strong>{e.label}</strong></td>
              <td><code>{e.output}</code></td>
              <td>{
                {
                  plain: 'Sentences, emails, tags fields',
                  compact: 'CSV cells, URL query strings',
                  sql: 'WHERE id IN (…) clauses',
                  json: 'API payloads, config files',
                  python: 'Scripts and notebooks',
                  semicolon: 'Outlook / Exchange recipient lists',
                  pipe: 'Markdown tables, log filters',
                  regex: 'Alternation patterns in search tools',
                }[e.id]
              }</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>Common situations where this saves time</h2>
    <h3>Building a SQL <code>IN</code> clause</h3>
    <p>
      You have a column of IDs from a report and need to query those exact rows. Paste the IDs, click <strong>SQL IN</strong>, and
      drop the result straight after <code>WHERE id IN</code>. For numeric IDs you may prefer no quotes at all — use the <strong>Plain</strong>
      preset and wrap the whole list in parentheses:
    </p>
    <pre><code>SELECT * FROM orders WHERE customer_id IN ({sqlExample});</code></pre>

    <h3>Addressing an email to a list of people</h3>
    <p>
      Most mail clients accept addresses separated by commas; Outlook traditionally expects semicolons. Paste the address column,
      choose the matching preset, and paste the result into the To or BCC field. Tick <em>Remove duplicates</em> first so nobody
      receives the message twice.
    </p>

    <h3>Turning spreadsheet rows into code</h3>
    <p>
      Product SKUs, country codes, feature flags — data often starts life in a spreadsheet and needs to end up in an array. The
      <strong>JSON array</strong> and <strong>Python list</strong> presets add the right quotes and brackets so the result parses
      on the first try.
    </p>

    <h3>Creating a keyword or tag list</h3>
    <p>
      Blog platforms, image libraries and ad managers frequently want tags as a single comma separated field. Convert the column,
      set the case to lowercase for consistency, and paste.
    </p>

    <h2>Doing the same job in a spreadsheet or in code</h2>
    <p>
      If you would rather stay inside your existing tools, these one-liners produce the same result. The web converter is simply
      faster when you need to do it once and move on.
    </p>

    <h3>Excel and Google Sheets</h3>
    <p>
      The <code>TEXTJOIN</code> function joins a range with a separator and can skip blank cells:
    </p>
    <pre><code>=TEXTJOIN(", ", TRUE, A1:A100)</code></pre>
    <p>
      To add quotes around every value, wrap the range in a text expression first. In Excel 365 and Google Sheets this works as a
      single array formula:
    </p>
    <pre><code>=TEXTJOIN(", ", TRUE, "'" &amp; A1:A100 &amp; "'")</code></pre>
    <p class="muted">Older Excel versions without <code>TEXTJOIN</code> need a helper column or a short VBA routine — another reason to use the converter above.</p>

    <h3>Python</h3>
    <pre><code>lines = [l.strip() for l in text.splitlines() if l.strip()]
result = ", ".join(lines)</code></pre>

    <h3>JavaScript</h3>
    <pre><code>const result = text.split(/\r?\n/).map(s =&gt; s.trim()).filter(Boolean).join(", ");</code></pre>

    <h3>Command line</h3>
    <pre><code>paste -sd, column.txt          # Linux / macOS
(Get-Content column.txt) -join ", "   # PowerShell</code></pre>

    <h2>Tips for clean results</h2>
    <ul>
      <li><strong>Watch the item counter.</strong> If it shows fewer items than lines, blank or duplicate lines were removed — expected, but worth a glance.</li>
      <li><strong>Sorting is number-aware.</strong> A–Z ordering puts <code>item2</code> before <code>item10</code>, unlike a plain character sort.</li>
      <li><strong>Values containing commas</strong> should be quoted before they go into a CSV file, otherwise a downstream parser will split them. The double-quote wrapper handles this.</li>
      <li><strong>Use “Use as input”</strong> to chain transformations: convert once, feed the result back, and convert again with different settings.</li>
    </ul>
  </article>

  <AdSlot slot="toolBottom" format="rectangle" />

  <Faq items={faq} />

  <aside class="related card">
    <h2>Related tools</h2>
    <ul>
      <li><a href="/comma-separated-list-to-column">Comma separated list to column</a> — the reverse operation: split any delimited text back into one item per line.</li>
    </ul>
  </aside>
</Base>

<style>
  .hero { margin-bottom: 1.25rem; max-width: 76ch; }
  .lead { font-size: 1.1rem; color: var(--text-muted); margin: 0; }
  kbd { font-family: var(--mono); font-size: 0.85em; border: 1px solid var(--border); border-bottom-width: 2px; border-radius: 4px; padding: 0.05em 0.4em; background: var(--surface); }
  .related { padding: 1rem 1.5rem; margin-top: 2rem; }
  .related h2 { margin-top: 0; font-size: 1.2rem; }
  .related ul { margin: 0; padding-left: 1.2rem; }
</style>
