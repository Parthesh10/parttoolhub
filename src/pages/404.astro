---
import Base from '../layouts/Base.astro';
import { CATEGORIES } from '../data/categories';
---

<Base title="Page not found" description="That page does not exist." noindex>
  <section class="prose nf">
    <h1>Page not found</h1>
    <p>The address may be mistyped, or the page may have moved. Try one of these instead:</p>
    <ul>
      <li><a href="/">Home — full tool directory</a></li>
      {CATEGORIES.map((c) => <li><a href={`/${c.slug}`}>{c.name}</a></li>)}
    </ul>
  </section>
</Base>

<style>
  .nf { padding-block: 2rem; }
</style>
