---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../site.config';
---

<Base title="Contact" description={`How to reach the ${SITE.name} team with bug reports, feature requests and other questions.`}>
  <Breadcrumbs items={[{ label: 'Contact' }]} />
  <article class="prose">
    <h1>Contact</h1>
    <p>
      Email <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a> and it reaches {SITE.author}, who builds
      and maintains every tool here (more on the <a href="/about">about page</a>).
      {SITE.github && (
        <>
          {' '}For bugs, an issue on <a href={SITE.github} rel="noopener">GitHub</a> works too.
        </>
      )}
    </p>
    <h2>What helps us help you</h2>
    <ul>
      <li><strong>Bug reports:</strong> which tool, which browser, a small sample of input that misbehaves, and what you expected to happen.</li>
      <li><strong>Feature requests:</strong> a sentence or two on the situation you are in — that tells us far more than a description of the button you want.</li>
      <li><strong>Privacy questions:</strong> see the <a href="/privacy-policy">privacy policy</a> first; if it does not answer your question, we would like to know so we can improve it.</li>
    </ul>
    <p class="muted">Every message is read; expect a reply to most within a few working days.</p>
  </article>
</Base>
