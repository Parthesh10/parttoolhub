---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../site.config';
---

<Base title="Contact" description={`How to reach ${SITE.author} with bug reports, feature requests and other questions about ${SITE.name}.`}>
  <Breadcrumbs items={[{ label: 'Contact' }]} />
  <article class="prose">
    <h1>Contact</h1>
    <p>
      {SITE.author} builds and maintains every tool here (more on the <a href="/about">about page</a>).
      {SITE.linkedin && <>The quickest way to reach me directly is <a href={SITE.linkedin} rel="noopener">LinkedIn</a>.</>}
      {SITE.github && (
        <>
          {' '}For bugs and feature requests specifically, open an <a href={`${SITE.github}/issues`} rel="noopener">issue on GitHub</a>.
          It keeps a public record other people hitting the same problem can find.
        </>
      )}
    </p>
    <h2>What helps us help you</h2>
    <ul>
      <li><strong>Bug reports:</strong> which tool, which browser, a small sample of input that misbehaves, and what you expected to happen.</li>
      <li><strong>Feature requests:</strong> a sentence or two on the situation you are in, since that tells us far more than a description of the button you want.</li>
      <li><strong>Privacy questions:</strong> see the <a href="/privacy-policy">privacy policy</a> first; if it does not answer your question, reach out and it will be improved.</li>
    </ul>
    <p class="muted">Every message is read; expect a reply to most within a few working days.</p>
  </article>
</Base>
