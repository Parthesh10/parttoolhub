---
import ToolLayout from '../../layouts/ToolLayout.astro';
import MarkdownToTextTool from '../../components/tools/MarkdownToTextTool.astro';
import { toolBySlug } from '../../data/tools';
import { parseMarkdown, renderText, summarize, SAMPLE_MARKDOWN, TEXT_MODES, PLAIN_STYLE, type TextMode } from '../../lib/markdown';

const tool = toolBySlug('markdown-to-plain-text');

// Every example below is produced by the real engine at build time.
const t = (md: string, mode: TextMode = 'plain') => renderText(parseMarkdown(md), TEXT_MODES[mode]);
const sampleBlocks = parseMarkdown(SAMPLE_MARKDOWN);
const stats = summarize(sampleBlocks);
const plainOut = renderText(sampleBlocks);
const slackHead = renderText(sampleBlocks, TEXT_MODES.slack).split('\n').slice(0, 3).join('\n');
const whatsappTail = renderText(sampleBlocks, TEXT_MODES.whatsapp).split('\n').slice(-2).join('\n');

const nested = t('- a\n- b\n  - b1\n    1. deep\n- c');
const snake = t('use snake_case_name and __init__ here');
const unclosed = t('a **never closed and *this* is fine');
const tasks = t('- [x] done\n- [ ] todo');
const image = t('![Logo](https://example.com/logo.png)');
const headingSlack = t('## Release notes', 'slack');
const codePlain = t('```js\nconst x = 1;\n```');
const codeSlack = t('```js\nconst x = 1;\n```', 'slack');
const linkDefault = t('See the [docs](https://example.com/docs).');
const linkUrl = renderText(parseMarkdown('See the [docs](https://example.com/docs).'), { ...PLAIN_STYLE, links: 'url' });
const linkText = renderText(parseMarkdown('See the [docs](https://example.com/docs).'), { ...PLAIN_STYLE, links: 'text' });
const sameLink = t('[https://example.com](https://example.com)');
const html = t('<b>kept</b> as typed');
const rule = t('before\n\n---\n\nafter');
const hardBreak = t('line one  \nline two\nline three');
const emptyOut = t('   \n\n');
const bulletsSlack = t('- one\n- two', 'slack');
const bulletsWhatsapp = t('- one\n- two', 'whatsapp');
if (nested !== '• a\n• b\n  • b1\n    1. deep\n• c') throw new Error('page claims nested lists indent under their parent');
if (snake !== 'use snake_case_name and init here') throw new Error('page claims underscores inside words are left alone');
if (emptyOut !== '') throw new Error('page claims empty input gives empty output');

const steps = [
  'Paste the Markdown — an answer from ChatGPT, Claude, Copilot or Cursor, a README, a Notion export — into the left box.',
  'Pick <strong>Output for</strong>: <strong>Plain text</strong> drops every symbol; <strong>Slack</strong>, <strong>WhatsApp</strong> and <strong>Google Chat</strong> rewrite the formatting in that app\'s own markup so it renders bold and italic there.',
  'Choose how <strong>Links</strong> are written: the text with the URL in brackets, the URL alone, or the text alone.',
  '<strong>Copy to clipboard</strong> (or <kbd>Ctrl</kbd>+<kbd>Enter</kbd> in the input box) and paste into the chat, form or email.',
];

const faq = [
  {
    q: 'Why do asterisks and hashes show up when I paste an AI answer into Teams or a web form?',
    a: 'Because the answer is written in Markdown — **double asterisks** for bold, # for headings, backticks for code — and the box you pasted into does not interpret it, so the symbols appear as typed. The AI app rendered them for you; the chat app does not. Converting to plain text first removes the symbols while keeping the bullets, numbers and tables the answer was organised with.',
  },
  {
    q: 'Does this remove the structure too, or only the symbols?',
    a: 'Only the symbols. Headings become their own line, bullet points become • lines (indented when nested), numbered lists keep their numbers, block quotes keep a > prefix, tables are laid out in aligned columns, code keeps every character, and links become "text (url)". Compare with the AI Text Cleaner, which strips the symbols in place and is the better choice when you want to keep the text as one flowing paragraph.',
  },
  {
    q: 'What is the difference between Plain text and the Slack, WhatsApp and Google Chat modes?',
    a: 'Plain text has no formatting at all. The three chat modes translate Markdown into the markup those apps document: single asterisks for bold, underscores for italic, single tildes for strikethrough, backticks for code, > for quotes. They differ in lists — Slack\'s markup mode has none, so bullets are • characters, while WhatsApp and Google Chat turn "- " into a bulleted list — and all three turn headings into a bold line, since none of them has headings.',
  },
  {
    q: 'Can I keep the links clickable?',
    a: 'Plain text has no clickable links, but most chat apps and email clients turn a bare URL into one. The default "Text (URL)" style writes each link as its text followed by the address in brackets; "URL only" writes just the address, which every app links; "Text only" drops the addresses for a printout or a message where they would be noise.',
  },
  {
    q: 'Is my text uploaded anywhere?',
    a: 'No. The Markdown is parsed and rewritten by JavaScript running in this page; there is no server, so nothing you paste can leave your device. You can load the page, go offline, and it still works.',
  },
];
---

<ToolLayout {tool} {steps} {faq}>
  <MarkdownToTextTool />

  <Fragment slot="content">
    <h2>What survives and what goes</h2>
    <p>
      AI assistants answer in Markdown. Paste that answer into Microsoft Teams, Google Chat, a Jira ticket, a CRM note or
      a web form and you get the raw symbols: <code>**</code> around every emphasised phrase, <code>#</code> in front of
      each heading, <code>|---|</code> rows under each table. This tool parses the Markdown the way a renderer would and
      writes it back out as text a person would type: the structure stays, the syntax goes.
    </p>
    <p>
      Kept: the words of every heading, bullet and numbered lists with their nesting, quoted lines, the full contents of
      code blocks, tables with their columns lined up, link addresses, image addresses, and the checked or unchecked
      state of task items. Removed: emphasis markers, heading hashes, backticks, link brackets, fence lines, horizontal
      rules and backslash escapes. Raw HTML in the input is left exactly as typed, because a chat box would show it
      literally either way. The <a href="/tools/ai-text-cleaner">AI Text Cleaner</a> is the sibling tool for the other
      approach: strip the symbols in place and also fix smart quotes, em dashes and hidden characters.
    </p>

    <h2>Example</h2>
    <p>
      <strong>Load sample</strong> inserts a deploy checklist with {stats.headings} heading, {stats.lists} lists (one nested, one
      of tasks), {stats.tables} table, {stats.codeBlocks} code block and {stats.links} links. In <strong>Plain text</strong> mode it becomes:
    </p>
    <pre><code>{plainOut}</code></pre>
    <p>
      Switch to <strong>Slack</strong> and the same input starts <code>{slackHead.split('\n')[0]}</code> — the heading as a bold
      line — with <code>*full test suite*</code> and <code>_two minutes_</code> in Slack's own markup, the table and the
      command wrapped in <code>```</code> so they stay monospace. <strong>WhatsApp</strong> writes the task list as
      <code>{whatsappTail.split('\n')[0]}</code>, using its "- " list syntax instead of the • character.
    </p>

    <h2>Options explained</h2>
    <ul>
      <li><strong>Output for: Plain text</strong> removes all formatting. Bullets are • characters, numbered items keep their numbers, quotes keep a <code>&gt; </code> prefix, tables are aligned in columns, code is written as-is with no fences.</li>
      <li><strong>Output for: Slack</strong> writes <code>*bold*</code>, <code>_italic_</code>, <code>~strike~</code>, <code>`code`</code>, <code>```</code> blocks and <code>&gt;</code> quotes, as Slack documents for its markup mode. Slack has no list syntax in that mode, so bullets stay • characters: <code>{bulletsSlack.split('\n')[0]}</code>. Headings become a bold line: <code>{headingSlack}</code>.</li>
      <li><strong>Output for: WhatsApp</strong> uses the same bold, italic, strikethrough and code markup, plus WhatsApp's own list syntax — <code>{bulletsWhatsapp.split('\n')[0]}</code> — which it renders as a bulleted list, and <code>1. </code> for numbered items.</li>
      <li><strong>Output for: Google Chat</strong> matches WhatsApp: Google Chat documents <code>- </code> bullets and <code>&gt;</code> quotes alongside the same emphasis characters.</li>
      <li><strong>Links: Text (URL)</strong> writes <code>{linkDefault}</code>; <strong>URL only</strong> writes <code>{linkUrl}</code>; <strong>Text only</strong> writes <code>{linkText}</code>. A link whose text is already its address is written once: <code>{sameLink}</code>.</li>
      <li><strong>Load sample</strong> inserts the checklist shown above; <strong>Clear</strong> empties both boxes.</li>
      <li><strong>Copy to clipboard</strong> and <strong>Download .txt</strong> take the right-hand box as it is. <kbd>Ctrl</kbd>+<kbd>Enter</kbd> in the input box copies.</li>
    </ul>

    <h2>Edge cases and common errors</h2>
    <ul>
      <li><strong>Nested lists keep their depth</strong> by indentation: <code>- a / - b / (two spaces) - b1 / (four) 1. deep / - c</code> becomes <code>{nested.replace(/\n/g, ' ⏎ ')}</code>, so a chat message still reads as an outline.</li>
      <li><strong>Underscores inside words are not emphasis.</strong> <code>snake_case_name</code> stays as written, as the CommonMark rules require; <code>__init__</code> on its own, however, is bold in Markdown, so it comes out as <code>init</code>: <code>{snake}</code>.</li>
      <li><strong>An unclosed marker stays literal.</strong> <code>a **never closed and *this* is fine</code> gives <code>{unclosed}</code> — the lone <code>**</code> is kept because nothing closes it, exactly as GitHub would show it.</li>
      <li><strong>Task lists</strong> become <code>{tasks.replace(/\n/g, ' ⏎ ')}</code>, using ☑ and ☐ so the state survives without brackets.</li>
      <li><strong>Images</strong> have no text form, so <code>![Logo](https://example.com/logo.png)</code> becomes <code>{image}</code>.</li>
      <li><strong>Code blocks</strong>: plain text keeps the code and drops the fences (<code>{codePlain}</code>); the chat modes keep the fences because the apps render them as monospace: <code>{codeSlack.replace(/\n/g, ' ⏎ ')}</code>. The language tag after the opening fence is dropped in every mode.</li>
      <li><strong>Tables</strong> are padded so columns line up in a monospace font, and the chat modes wrap them in a code block for that reason. In a proportional font the columns drift; that is the trade-off for a table with no pipes and dashes to strip.</li>
      <li><strong>Horizontal rules disappear.</strong> <code>---</code> between two paragraphs is a pause, not content: <code>{rule.replace(/\n/g, ' ⏎ ')}</code>.</li>
      <li><strong>Line breaks</strong> follow Markdown's rules: two trailing spaces or a backslash make a real break; a bare newline inside a paragraph is a space. <code>{hardBreak.replace(/\n/g, ' ⏎ ')}</code>.</li>
      <li><strong>HTML tags in the input</strong> are not interpreted: <code>{html}</code>.</li>
      <li><strong>No Markdown at all</strong> gives the input back unchanged, and the status line says so rather than leaving you to compare two identical boxes. <strong>Empty input</strong> gives empty output.</li>
      <li><strong>Size</strong>: half a megabyte of Markdown (thousands of headings, lists and tables) parses and renders in well under a second; typing is debounced so keystrokes never wait on it.</li>
    </ul>

    <h2>Do the same thing in code</h2>
    <h3>Shell (pandoc)</h3>
    <pre><code>pandoc -f gfm -t plain answer.md            # plain text, structure kept
pandoc -f gfm -t plain --wrap=none answer.md  # no re-wrapping of long lines</code></pre>
    <h3>Python</h3>
    <pre><code>{`import markdown
from bs4 import BeautifulSoup

html = markdown.markdown(text, extensions=["tables", "fenced_code"])
plain = BeautifulSoup(html, "html.parser").get_text("\\n")`}</code></pre>
    <h3>JavaScript (Node.js)</h3>
    <pre><code>{`import { marked } from "marked";
import { convert } from "html-to-text";

const plain = convert(marked.parse(text), { wordwrap: false });`}</code></pre>
    <p>
      Each of those goes through HTML and loses the chat-markup step; for Slack, WhatsApp or Google Chat markup use the
      modes above. If the pasted text is not going into a chat but into a document,
      <a href="/tools/markdown-to-google-docs">Markdown to Google Docs</a> keeps the formatting instead of removing it,
      and if the text needs its curly quotes and dashes straightened as well, run it through the
      <a href="/tools/ai-text-cleaner">AI Text Cleaner</a> afterwards. Lists that come out one item per line can be
      joined with the <a href="/tools/column-to-comma-separated-list">column to comma separated list</a> tool.
    </p>
  </Fragment>
</ToolLayout>
