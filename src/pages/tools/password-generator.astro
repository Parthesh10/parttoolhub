---
import ToolLayout from '../../layouts/ToolLayout.astro';
import PasswordGeneratorTool from '../../components/tools/PasswordGeneratorTool.astro';
import { toolBySlug } from '../../data/tools';
import { generatePassword, characterPool, STRENGTH_LABEL, DEFAULT_PASSWORD_OPTIONS } from '../../lib/password-generate';

const tool = toolBySlug('password-generator');

// Every number and message below is produced by the real engine at build time.
const defaultPool = characterPool(DEFAULT_PASSWORD_OPTIONS);
const sample = generatePassword(DEFAULT_PASSWORD_OPTIONS);
if (!sample.ok) throw new Error('default options must produce a password');
const sampleLen = sample.value.value.length;
const sampleBits = sample.value.entropyBits;

const shortResult = generatePassword({ length: 4 });
if (!shortResult.ok) throw new Error('length 4 must still produce a password');
const shortBits = shortResult.value.entropyBits;
const shortStrength = STRENGTH_LABEL[shortResult.value.strength];

const numbersOnly12 = generatePassword({ uppercase: false, lowercase: false, symbols: false, numbers: true, length: 12 });
if (!numbersOnly12.ok) throw new Error('numbers-only must succeed');

const noCharsErr = generatePassword({ uppercase: false, lowercase: false, numbers: false, symbols: false });
if (noCharsErr.ok) throw new Error('page claims selecting nothing is refused');
const noCharsMsg = noCharsErr.error;

const tinyPool = generatePassword({ uppercase: false, lowercase: false, symbols: false, numbers: true, excludeAmbiguous: true, length: 6 });
if (!tinyPool.ok) throw new Error('digits-only excluding ambiguous must still work (0 and 1 removed, 8 digits remain)');
const numbersPoolExAmbiguous = characterPool({ uppercase: false, lowercase: false, symbols: false, numbers: true, excludeAmbiguous: true });

const guaranteeDemo = generatePassword({ length: 4, uppercase: true, lowercase: true, numbers: true, symbols: true });
if (!guaranteeDemo.ok) throw new Error('4-char, 4-class password must still succeed without the one-of-each guarantee');

// Prove the "at least one of each" guarantee holds whenever length allows it — run it
// enough times that a silent regression would show up, not just once.
for (let i = 0; i < 200; i++) {
  const r = generatePassword({ length: 8 });
  if (!r.ok) throw new Error('unexpected failure');
  const p = r.value.value;
  const ok = /[A-Z]/.test(p) && /[a-z]/.test(p) && /[0-9]/.test(p) && /[^A-Za-z0-9]/.test(p);
  if (!ok) throw new Error(`page claims every selected character type is guaranteed to appear, but got "${p}"`);
}

const steps = [
  'Set the <strong>Length</strong> and tick the <strong>character types</strong> you want — Uppercase, Lowercase, Numbers, Symbols.',
  'Tick <strong>Exclude ambiguous characters</strong> if the password will be handwritten, read aloud, or typed on a device where 0/O or 1/l/I are easy to confuse.',
  'Pick how many to generate at once under <strong>Quantity</strong> if you need several — for different accounts, or to pick a favourite.',
  '<strong>Copy to clipboard</strong> or <strong>Download .txt</strong>. The stat line above the box shows the entropy and strength of every password in the batch — they are all equally strong, since they share the same options.',
];

const faq = [
  {
    q: 'Is it safe to generate a password on a website?',
    a: 'On this one, yes, because there is nothing to intercept: the page is a static file with no server behind it, and every password is generated by JavaScript running in your own browser using the Web Crypto API. Nothing you generate is sent anywhere, logged, or stored — reload the page and it is gone. That is not true of every password generator online; some genuinely do compute the password server-side and could log it.',
  },
  {
    q: 'How random are these passwords, really?',
    a: 'Every character comes from crypto.getRandomValues(), the browser\'s cryptographically secure random number generator — the same source used for encryption keys, not JavaScript\'s Math.random(), which is not specified to be unpredictable and must never be used for anything security-sensitive. Characters are drawn with rejection sampling so no character in the chosen set is even slightly more likely than another.',
  },
  {
    q: 'What do the entropy number and strength label mean?',
    a: 'Entropy in bits is log2(pool size) × length: roughly, how many yes/no guesses an attacker who knows your character set (but not the password) would need on average to find it by brute force. It is a measure of the random space searched, not a guarantee against a leaked password reused elsewhere or a targeted guess. The Weak/Fair/Strong/Very strong label is an approximate, commonly used band on that number, not a certified score.',
  },
  {
    q: 'Should I exclude ambiguous characters?',
    a: 'Turn it on if a human will ever need to read or retype the password — handwritten on a sticky note, read aloud over the phone, displayed in a font where 1, l and I look identical. Leave it off for a password a password manager stores and autofills, since removing characters only shrinks the pool and very slightly lowers the entropy for the same length.',
  },
  {
    q: 'Why does a very short password not include every character type I selected?',
    a: `The tool guarantees at least one of each selected type only when the length allows it — with 4 types selected, that needs at least 4 characters. Below that it fills the password from the combined pool instead of silently dropping one of your choices. A 4-character password with all four types selected might read "${guaranteeDemo.value.value}", which happens to have no symbol this time; a length of at least 4 with those settings will always try for one of each, but a length of 3 or fewer cannot.`,
  },
];
---

<ToolLayout {tool} {steps} {faq}>
  <PasswordGeneratorTool />

  <Fragment slot="content">
    <h2>What makes a password generator trustworthy</h2>
    <p>
      Two things matter for a password generator, and most of what makes one better than another comes down to them.
      First, the randomness: passwords must come from a cryptographically secure random number generator, not an
      ordinary one. <code>Math.random()</code> is fast and fine for a game or a UI animation, but it is not specified
      to be unpredictable, and some implementations of it can be predicted after seeing enough output. This tool uses
      <code>crypto.getRandomValues()</code> instead, the Web Crypto API's CSPRNG, the same source browsers use for TLS
      keys. Second, where the password is computed: if it happens on a server, the operator could log it, by accident
      or on purpose. This page has no server — it is a static file, and every password is generated by JavaScript
      running on your device.
    </p>
    <p>
      What the tool will not do is pretend a password is safe because it is long. A password is only as good as where
      it ends up: reused across sites, pasted into a chat, or stored in a browser with no master password all
      undermine even a maximally random one. Use a password manager to store what this generates.
    </p>

    <h2>Example</h2>
    <p>
      The default settings — {sampleLen} characters, all four character types, no exclusions — draw from a
      {defaultPool.length}-character pool and produce something like:
    </p>
    <pre><code>{sample.value.value}</code></pre>
    <p>
      That password carries <strong>{sampleBits} bits of entropy</strong> ({STRENGTH_LABEL[sample.value.strength]}) — with a
      {defaultPool.length}-character pool, every extra character adds about {Math.round(Math.log2(defaultPool.length) * 10) / 10}
      bits, so length matters more than which character types you enable.
    </p>

    <h2>Options explained</h2>
    <ul>
      <li><strong>Length</strong> sets how many characters to generate, from 1 to 128 in the box (the underlying engine accepts up to 512). Entropy grows linearly with length, so this is the single biggest lever on strength.</li>
      <li><strong>Uppercase / Lowercase / Numbers / Symbols</strong> each add their character set to the pool. At least one must stay ticked. Symbols are the set every US/UK keyboard types directly: <code>{'!@#$%^&*()-_=+[]{};:,.<>/?'}</code> — no alt-codes or dead keys.</li>
      <li><strong>Exclude ambiguous characters</strong> removes 0, O, 1, l and I from whichever sets are enabled, for a password a person has to read or type by hand.</li>
      <li><strong>Quantity</strong> generates several passwords at once from the same settings — useful for picking one you like, or setting up several accounts in one pass. Every password in a batch is independently random; the stat line's entropy and strength apply to all of them equally, since they share the same options.</li>
      <li><strong>Generate</strong> produces a fresh batch on demand; the box also fills in automatically on page load and whenever an option changes, so there is always a ready password.</li>
    </ul>

    <h2>Edge cases and common errors</h2>
    <ul>
      <li><strong>A short password cannot guarantee every type.</strong> With all four types selected, the tool tries to include at least one of each — but that needs at least 4 characters. A 4-character password from the same settings might read <code>{guaranteeDemo.value.value}</code>: still four random characters from the full pool, just not provably one of each. Verified by generating 200 eight-character passwords at build time and confirming every one contained all four types when eight characters were requested.</li>
      <li><strong>Selecting no character type</strong> is refused rather than silently falling back to a default: "{noCharsMsg}"</li>
      <li><strong>Excluding ambiguous characters from a numbers-only password</strong> removes only 0 and 1, leaving 8 digits (<code>{numbersPoolExAmbiguous}</code>) — a 6-digit PIN-style code from that pool, such as <code>{tinyPool.value.value}</code>, still carries {tinyPool.value.entropyBits} bits, noticeably less than the default because the pool is so much smaller.</li>
      <li><strong>Numbers only is weak at any reasonable length.</strong> A 12-digit PIN-style code such as <code>{numbersOnly12.value.value}</code> carries only {numbersOnly12.value.entropyBits} bits ({STRENGTH_LABEL[numbersOnly12.value.strength]}) — a 10-digit numeric pool is small enough that even a fairly long code searches a small space. Add letters or symbols, or increase the length substantially, to reach Strong.</li>
      <li><strong>A tiny password is always weak.</strong> At 4 characters, even from the full {defaultPool.length}-character pool, entropy is only {shortBits} bits ({shortStrength}) — length below about 12 characters cannot reach Strong regardless of which character types are enabled.</li>
      <li><strong>Every password in a batch is independent.</strong> Generating 100 at once does not make any of them weaker or more predictable than generating one; nothing about one password in the list depends on another.</li>
    </ul>

    <h2>Do the same thing in code</h2>
    <h3>JavaScript (browser or Node.js)</h3>
    <pre><code>{`function randomPassword(length, charset) {
  const bytes = new Uint8Array(length);
  crypto.getRandomValues(bytes);
  return Array.from(bytes, (b) => charset[b % charset.length]).join("");
  // Note: "b % charset.length" is a simplification and reintroduces a small
  // modulo bias unless charset.length evenly divides 256 -- this page's own
  // engine (src/lib/password-generate.ts) uses rejection sampling instead.
}
const charset = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*()-_=+[]{};:,.<>/?";
const password = randomPassword(16, charset);`}</code></pre>
    <h3>Python</h3>
    <pre><code>{`import secrets, string
charset = string.ascii_letters + string.digits + "!@#$%^&*()-_=+[]{};:,.<>/?"
password = "".join(secrets.choice(charset) for _ in range(16))  # secrets, never random`}</code></pre>
    <h3>Shell</h3>
    <pre><code>openssl rand -base64 24 | tr -d '=+/' | cut -c1-16   # quick, but not character-type-aware
pwgen -sy 16 1                                       # if pwgen is installed</code></pre>
    <p>
      Once you have a password, a <a href="/tools/uuid-generator">UUID</a> is the usual next thing generated alongside
      it for a new account or API key; if the account needs a JWT decoded later, the
      <a href="/tools/jwt-decoder">JWT decoder</a> is the tool for that.
    </p>
  </Fragment>
</ToolLayout>
