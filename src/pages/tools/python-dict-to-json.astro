---
import ToolLayout from '../../layouts/ToolLayout.astro';
import PythonDictTool from '../../components/tools/PythonDictTool.astro';
import { toolBySlug } from '../../data/tools';
import { pythonToJson } from '../../lib/python-dict';
import CodeScript from '../../components/CodeScript.astro';
import pythonScript from '../../lib/python/python_dict_to_json.py?raw';

const tool = toolBySlug('python-dict-to-json');

// Worked example and every error message below come from the real engine at build time.
const pySample = "{'id': 7, 'active': True, 'ref': None, 'tags': ('a', 'b')}";
const jsonSample = (pythonToJson(pySample) as { ok: true; output: string }).output;
const err = (s: string) => {
  const r = pythonToJson(s);
  return r.ok ? '' : r.error.replace(/\.$/, ''); // quoted inline, so drop the message's own full stop
};
const datetimeErr = err("{'d': datetime.datetime(2024, 1, 1)}");
const decimalErr = err("{'d': Decimal('1.5')}");
const jsonInputErr = err('{"a": true}');
const tupleKeyErr = err("{(1, 2): 'a'}");
const mixedKeys = (pythonToJson("{1: 'a', 2.5: 'b', True: 'c', None: 'd'}", { indent: 0 }) as { ok: true; output: string }).output;
const bigInt = (pythonToJson("{'id': 12345678901234567890}", { indent: 0 }) as { ok: true; output: string }).output;
const floats = (pythonToJson('[1.0, 1e16, 0.00001]', { indent: 0 }) as { ok: true; output: string }).output;
const keyOrder = (pythonToJson("{'b': 1, '2': 2, 'a': 3}", { indent: 0 }) as { ok: true; output: string }).output;

const steps = [
  'Paste the Python literal (a dict, list, tuple, set or a single value) exactly as <code>print()</code>, the REPL, a debugger or a log line showed it.',
  'Choose the indent: 2 spaces, 4 spaces, Tab, or <em>Minified</em> for a single line.',
  'Tick <strong>Sort keys alphabetically</strong> if you need a stable order for diffing.',
  'If it does not convert, read the error line: it names the first thing the parser could not treat as a literal value.',
  '<strong>Copy to clipboard</strong> or <strong>Download .json</strong>.',
];

const faq = [
  {
    q: 'Why can’t I just use JSON.parse on a printed Python dict?',
    a: 'Python’s repr() uses single quotes and the literals True, False and None, none of which are valid JSON. JSON.parse rejects them immediately. This tool understands Python’s literal syntax specifically and converts it to the equivalent JSON.',
  },
  {
    q: 'What happens to tuples and sets?',
    a: 'Both become JSON arrays, since JSON has no equivalent of either. Order is preserved for tuples; sets have no defined order in Python either, so their order in the output matches whatever order they were written in.',
  },
  {
    q: 'Does it handle nested dicts and multi-line dicts pasted from a debugger?',
    a: 'Yes, any level of nesting, trailing commas, and Python comments (<code>#…</code>) are all handled, which covers most values copied from a REPL, a debugger watch panel, or a print() call.',
  },
  {
    q: 'What if a value is a variable name, not a literal?',
    a: 'The converter only understands literal values (strings, numbers, True/False/None, lists, dicts, tuples, sets): the same set JSON can represent. A bare variable name like <code>some_var</code> has no fixed value to convert, so it is reported as an error rather than guessed at.',
  },
];
---

<ToolLayout {tool} {steps} {faq}>
  <PythonDictTool />

  <Fragment slot="content">
    <h2>Why this conversion needs its own parser</h2>
    <p>
      When you <code>print()</code> a Python dictionary, or paste one from a Jupyter notebook, debugger or log line, what you
      get back is Python's own literal syntax, not JSON. The two look almost identical but differ in exactly the spots that
      make a strict JSON parser fail: single quotes instead of double, <code>True</code>/<code>False</code>/<code>None</code>
      instead of <code>true</code>/<code>false</code>/<code>null</code>, and Python-only types like tuples and sets that JSON
      has no syntax for at all.
    </p>
    <p>
      This tool runs a small Python-literal parser (not <code>eval()</code>, and nothing is executed) that understands that
      syntax directly, then re-serialises the result as JSON. That lets you take output straight from a Python script and paste
      it into a config file, an API request body, or a JSON-only tool. It follows the same rules as <code>json.dumps</code> for
      the awkward parts: non-string keys, <code>nan</code>, and duplicate keys.
    </p>

    <h2>Example</h2>
    <p>A dict as Python prints it:</p>
    <pre><code>{pySample}</code></pre>
    <p>becomes:</p>
    <pre><code>{jsonSample}</code></pre>

    <h2>What gets converted</h2>
    <ul>
      <li><strong>Quotes:</strong> single, double and triple-quoted strings, including <code>r'raw'</code>, <code>u'unicode'</code>, <code>b'bytes'</code> (treated as text) and adjacent-string concatenation (<code>'a' 'b'</code> → <code>"ab"</code>).</li>
      <li><strong>Constants:</strong> <code>True</code> → <code>true</code>, <code>False</code> → <code>false</code>, <code>None</code> → <code>null</code>.</li>
      <li><strong>Numbers:</strong> ints, floats, signs, underscores in literals (<code>1_000</code>), and hex/octal/binary (<code>0xff</code>, <code>0o17</code>, <code>0b101</code>) all become plain decimal numbers.</li>
      <li><strong>Containers:</strong> lists stay arrays; tuples and sets become arrays; nested dicts stay objects. <code>set()</code>, <code>dict()</code>, <code>list()</code>, <code>tuple()</code> and <code>frozenset()</code> calls are unwrapped, and so are <code>OrderedDict</code> (either form) and <code>Counter</code>.</li>
      <li><strong>Extras:</strong> trailing commas and <code>#</code> comments are ignored, matching how Python itself reads them.</li>
    </ul>

    <h2>Options explained</h2>
    <ul>
      <li><strong>Indent: 2 spaces / 4 spaces / Tab / Minified</strong> sets the output layout. Minified is one line with no spaces at all, the same as <code>json.dumps(obj, separators=(",", ":"))</code>.</li>
      <li><strong>Sort keys alphabetically</strong> sorts every object's keys at every depth in code-point order, like <code>json.dumps(obj, sort_keys=True)</code>; uppercase keys therefore come before lowercase ones.</li>
      <li><strong>Load sample</strong> inserts a small dict that uses single quotes, <code>True</code>, <code>None</code> and a tuple; <strong>Clear</strong> empties the box.</li>
    </ul>

    <h2>Edge cases and common errors</h2>
    <ul>
      <li><strong>Object reprs are not literals.</strong> <code>datetime.datetime(2024, 1, 1)</code> stops with “{datetimeErr}”, <code>Decimal('1.5')</code> with “{decimalErr}”, and <code>&lt;User id=1&gt;</code> or the <code>&lt;class 'int'&gt;</code> inside a printed <code>defaultdict</code> at the <code>&lt;</code>. Convert those values to strings in Python before printing, or edit them out.</li>
      <li><strong>Text that is already JSON fails</strong>: <code>{'{"a": true}'}</code> is reported as “{jsonInputErr}”, because <code>true</code> is not a Python name. Use the <a href="/tools/json-formatter">JSON Formatter</a> to work with it as JSON, or the <a href="/tools/json-to-python-dict">JSON to Python Dict</a> converter to go in the opposite direction.</li>
      <li><strong>Non-string keys follow <code>json.dumps</code>:</strong> <code>{"{1: 'a', 2.5: 'b', True: 'c', None: 'd'}"}</code> becomes <code>{mixedKeys}</code>. A tuple key such as <code>{"{(1, 2): 'a'}"}</code> is rejected with “{tupleKeyErr}”.</li>
      <li><strong><code>float('nan')</code>, <code>float('inf')</code>, <code>nan</code> and <code>inf</code> become <code>null</code></strong>, because JSON cannot express them. Python's own <code>json.dumps</code> would emit the non-standard <code>NaN</code> unless you pass <code>allow_nan=False</code>.</li>
      <li><strong>Duplicate keys keep the last value</strong>, exactly as Python does when it builds the dict.</li>
      <li><strong>Large integers keep every digit</strong>: <code>{"{'id': 12345678901234567890}"}</code> becomes <code>{bigInt}</code>, as it would from Python's own <code>json.dumps</code>. Integers are converted as exact whole numbers, never through a JavaScript number, which would round anything above 2<sup>53</sup> (this one to <code>12345678901234567000</code>). Whether the program that reads the JSON keeps every digit is a separate question: JavaScript's <code>JSON.parse</code> does not, so an ID that big is safer sent as a string.</li>
      <li><strong>Floats are written the way <code>json.dumps</code> writes them</strong>: <code>[1.0, 1e16, 0.00001]</code> becomes <code>{floats}</code>. A float keeps its <code>.0</code>, so it stays a float when Python reads it back.</li>
      <li><strong>Keys keep the order you wrote them in</strong>, digit-only keys included: <code>{"{'b': 1, '2': 2, 'a': 3}"}</code> becomes <code>{keyOrder}</code>. (A plain JavaScript object would have moved <code>"2"</code> to the front.)</li>
      <li><strong>f-strings are not evaluated</strong>: <code>f'hi {'{x}'}'</code> is kept literally as <code>"hi {'{x}'}"</code>. Complex numbers (<code>1+2j</code>) are rejected outright.</li>
      <li><strong>Anything after the value is an error</strong>, not ignored: <code>{"{'a': 1} extra"}</code> stops at <code>extra</code>. Paste one value at a time.</li>
      <li><strong>Size:</strong> a 4 MB literal takes about half a second to parse on a laptop, and typing is debounced so the page stays responsive while you edit.</li>
    </ul>

    <h2>Do the same thing in Python</h2>
    <p>If the text is plain literals and you are already inside a Python process, two lines do it:</p>
    <pre><code>import json, ast
data = ast.literal_eval(python_repr_string)
print(json.dumps(data, indent=2))</code></pre>
    <p>
      <code>ast.literal_eval</code> is the safe alternative to <code>eval()</code>: it only accepts literal values and never runs
      code. It stops on several things a debugger or log line prints, though: <code>OrderedDict([...])</code>,
      <code>Counter(...)</code>, <code>nan</code> and <code>float('nan')</code>. <code>json.dumps</code> then fails on a set
      (<code>Object of type set is not JSON serializable</code>) and writes a NaN as <code>NaN</code>, which is not JSON.
    </p>
    <p>
      This script reads everything the tool reads and writes the same JSON: sets in the order they were written, NaN and
      infinity as <code>null</code>, every digit of a large integer. It needs Python 3.9 or later and only the standard
      library, and like <code>literal_eval</code> it never runs any of the text.
    </p>
    <CodeScript code={pythonScript} filename="python_dict_to_json.py" />
    <p>
      Run it on a file or pipe text through it; <code>--indent</code> takes <code>2</code>, <code>4</code>, <code>tab</code> or
      <code>0</code> (one compact line), and <code>--sort-keys</code> sorts every object's keys:
    </p>
    <pre><code>python python_dict_to_json.py debug_output.txt &gt; data.json
python python_dict_to_json.py --indent 4 --sort-keys &lt; pasted.txt</code></pre>
    <p>
      From your own code: <code>from python_dict_to_json import python_to_json</code>, then
      <code>python_to_json(text, indent=2)</code>. It raises <code>PyLiteralError</code>, a <code>ValueError</code>, with the
      same message the tool shows.
    </p>
    <p class="muted">
      The site's test suite runs this script and the tool on the same inputs (the tool's own test cases plus about a
      thousand generated literals: nested containers, large integers in four bases, floats written six ways, strings with
      every kind of escape, and damaged copies of them) and fails on any difference in the JSON or the error message. Where
      Python's own <code>ast.literal_eval</code> and <code>json.dumps</code> can read an input, the output must match theirs too.
    </p>
  </Fragment>
</ToolLayout>
