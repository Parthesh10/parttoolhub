---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Base64Tool from '../../components/tools/Base64Tool.astro';
import { toolBySlug } from '../../data/tools';
import { encodeBase64, decodeBase64 } from '../../lib/encoding';

const tool = toolBySlug('base64-encode-decode');

// Examples and error messages are produced by the real engine at build time.
const sample = 'Hello, world!';
const encoded = encodeBase64(sample);
const stdAlphabet = encodeBase64('>>??');
const urlAlphabet = encodeBase64('>>??', { urlSafe: true });
const errText = (s: string) => {
  const r = decodeBase64(s);
  return r.ok ? '' : r.error.replace(/\.$/, ''); // quoted inline, so drop the message's own full stop
};
const danglingErr = errText('YQFFF');
const alphabetErr = errText('data:text/plain;base64,aGk=');
const binaryErr = errText('/w==');
const loneSurrogate = encodeBase64('a' + String.fromCharCode(0xd800) + 'b'); // half a broken emoji, built from its code point

const steps = [
  'Choose <strong>Encode</strong> (text to Base64) or <strong>Decode</strong> (Base64 to text). The box labels change to match.',
  'Paste or type into the left box; the result appears on the right as you type.',
  'When encoding, tick <strong>URL-safe alphabet</strong> for anything that will live in a URL, and <strong>Omit "=" padding</strong> if the receiving system does not expect it.',
  '<strong>Copy to clipboard</strong>, or press <strong>⇄ Swap</strong> to send the result back through in the other direction and confirm it round-trips.',
];

const faq = [
  {
    q: 'Is Base64 encryption?',
    a: 'No. Base64 is a reversible encoding, not a cipher — anyone can decode it back to the original text with no key or password. It exists to safely represent binary or Unicode data using only the 64 characters that are guaranteed safe in contexts like email headers, URLs, and older text-only systems.',
  },
  {
    q: 'What is “URL-safe” Base64?',
    a: 'Standard Base64 uses "+" and "/", both of which have special meaning inside a URL. The URL-safe variant replaces them with "-" and "_" so the encoded text can be used directly in a URL path or query string without extra escaping.',
  },
  {
    q: 'Why does decoding sometimes fail?',
    a: 'Base64 text must be made up only of A–Z, a–z, 0–9, "+", "/" (or "-", "_" for the URL-safe variant) and optional "=" padding. If you paste text that includes a "data:" prefix, or the string was truncated to a length Base64 cannot produce, decoding reports exactly what looks wrong.',
  },
  {
    q: 'Does this handle emoji and non-English text?',
    a: 'Yes — text is encoded as UTF-8 bytes before Base64, so accented letters, CJK text and emoji all round-trip correctly. Decoding a value that was not UTF-8 to begin with (an image, say) is reported as an error rather than shown as garbage.',
  },
];
---

<ToolLayout {tool} {steps} {faq}>
  <Base64Tool />

  <Fragment slot="content">
    <h2>What Base64 is for</h2>
    <p>
      Base64 turns arbitrary bytes into text made up of only 64 printable ASCII characters (A–Z, a–z, 0–9, "+", "/"), plus
      "=" for padding. That makes it safe to embed binary data — or text using characters some systems can't handle — inside
      formats that only guarantee plain ASCII will survive: email (MIME attachments), URLs, JSON strings, and configuration
      files. The trade-off is size: every 3 bytes become 4 characters, so the output is roughly a third larger than the input.
    </p>
    <p>
      It is not encryption. Encoding and decoding require no secret, so Base64 should never be used as a way to hide
      sensitive data — only to safely transport it through systems that would otherwise mangle raw bytes. The alphabet,
      padding and URL-safe variant used here are the ones defined in RFC 4648.
    </p>

    <h2>Example</h2>
    <p>Encoding <code>{sample}</code> produces:</p>
    <pre><code>{encoded}</code></pre>
    <p>
      The two trailing <code>=</code> signs are padding: 13 bytes is not a multiple of 3, so the last group is filled out.
      Decoding <code>{encoded}</code> — with or without the padding — gives <code>{sample}</code> back.
    </p>

    <h2>Options explained</h2>
    <ul>
      <li><strong>Encode / Decode</strong> sets the direction. Encoding first converts your text to UTF-8 bytes, so any character works; decoding reverses that and reports an error if the bytes are not valid UTF-8.</li>
      <li><strong>⇄ Swap</strong> moves the output into the input box and flips the direction — a one-click round-trip check.</li>
      <li><strong>URL-safe alphabet (- and _ instead of + and /)</strong> selects the “base64url” variant from RFC 4648 §5: <code>&gt;&gt;??</code> encodes as <code>{stdAlphabet}</code> in standard Base64 and <code>{urlAlphabet}</code> URL-safe. Decoding accepts both alphabets without being told which one.</li>
      <li><strong>Omit "=" padding</strong> drops the trailing equals signs. JWT segments and most URL tokens are written this way. Decoding never requires padding, so this is safe for anything that will be decoded here.</li>
      <li><strong>Load sample</strong> inserts <code>Hello, world! 👋</code> — the emoji is four bytes in UTF-8, so it shows non-ASCII surviving the round trip.</li>
    </ul>

    <h2>Edge cases and common errors</h2>
    <ul>
      <li><strong>Line breaks and spaces</strong> inside Base64 are ignored when decoding, so a value wrapped at 76 columns by an email client or copied out of a PEM certificate decodes as-is.</li>
      <li><strong>Missing padding is fine</strong>: <code>YQ</code> decodes to <code>a</code>. A length Base64 cannot produce — one dangling character, such as <code>YQFFF</code> — is rejected with “{danglingErr}”.</li>
      <li><strong>A <code>data:</code> prefix is not Base64.</strong> Pasting <code>data:image/png;base64,…</code> whole gives “{alphabetErr}”. Paste only the part after the comma.</li>
      <li><strong>Binary data has no text to show.</strong> Decoding an image, a PDF or <code>/w==</code> reports “{binaryErr}”. The decode itself is fine: for an image, paste the same string into <a href="/tools/base64-to-image">Base64 to Image</a> to see and download it; for other files use a command-line tool such as <code>base64 -d</code>.</li>
      <li><strong>Newlines are bytes too.</strong> <code>a</code>, a line break and <code>b</code> encode together as <code>{encodeBase64('a\nb')}</code>, not as two separate values.</li>
      <li><strong>Empty input</strong> produces an empty output in both directions, with no error shown.</li>
      <li><strong>Half an emoji</strong> — a lone surrogate (a broken character left by a truncated paste) is encoded as U+FFFD, the replacement character, so <code>a</code> + a lone surrogate + <code>b</code> gives <code>{loneSurrogate}</code> rather than an error. Multi-megabyte inputs encode in well under a second.</li>
    </ul>

    <h2>Where you'll run into Base64</h2>
    <ul>
      <li><strong>HTTP Basic Authentication</strong> — the <code>Authorization: Basic …</code> header is <code>username:password</code> Base64-encoded (not encrypted — HTTPS is what protects it in transit).</li>
      <li><strong>Data URIs</strong> — <code>data:image/png;base64,…</code> embeds an image directly inside HTML or CSS. <a href="/tools/image-to-base64">Image to Base64</a> builds one from a file; <a href="/tools/base64-to-image">Base64 to Image</a> shows what one contains.</li>
      <li><strong>JWTs</strong> — each of the three dot-separated segments is Base64URL-encoded JSON; the <a href="/tools/jwt-decoder">JWT decoder</a> unpacks all three at once.</li>
      <li><strong>Email attachments</strong> — MIME encodes binary files as Base64 so they survive text-only mail transport.</li>
      <li><strong>Query strings</strong> — a Base64 value with <code>+</code> or <code>/</code> in it must be <a href="/tools/url-encode-decode">URL-encoded</a> as well, or use the URL-safe alphabet and skip that step.</li>
    </ul>

    <h2>Do the same thing in code</h2>
    <h3>JavaScript</h3>
    <pre><code>// Browser: go through UTF-8 bytes so non-ASCII text works
const bytes = new TextEncoder().encode(text);
const encoded = btoa(Array.from(bytes, (b) =&gt; String.fromCharCode(b)).join(""));
const decoded = new TextDecoder().decode(Uint8Array.from(atob(encoded), (c) =&gt; c.charCodeAt(0)));

// Node.js
const encoded2 = Buffer.from(text, "utf8").toString("base64");
const urlSafe = Buffer.from(text, "utf8").toString("base64url");</code></pre>
    <h3>Python</h3>
    <pre><code>import base64
encoded = base64.b64encode(text.encode("utf-8")).decode("ascii")
decoded = base64.b64decode(encoded).decode("utf-8")
url_safe = base64.urlsafe_b64encode(text.encode("utf-8")).rstrip(b"=")</code></pre>
    <h3>Shell</h3>
    <pre><code>printf 'Hello, world!' | base64          # encode
printf 'SGVsbG8sIHdvcmxkIQ==' | base64 -d  # decode</code></pre>
  </Fragment>
</ToolLayout>
